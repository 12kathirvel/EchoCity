<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#03080b">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="ECHO CITY X">
<title>ECHO CITY X</title>
<style>
:root{--cyan:#72f7ff;--cyan2:#cfffff;--red:#ff6578;--green:#66ffb1;--ink:#02080b;--glass:rgba(3,13,18,.74)}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#02070a;color:#e9ffff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}button{font:inherit}#app{position:relative;width:100%;height:100%;overflow:hidden}#game{position:absolute;inset:0;width:100%;height:100%;display:block;background:#03090c}.hidden{display:none!important}.screen{position:absolute;inset:0;z-index:30;display:grid;place-items:center;background:radial-gradient(circle at 50% 45%,rgba(0,222,255,.07),transparent 35%),linear-gradient(180deg,rgba(1,7,10,.78),rgba(1,5,8,.92));overflow:hidden}.noise{position:absolute;inset:0;opacity:.08;background-image:radial-gradient(#fff .5px,transparent .5px);background-size:4px 4px;mix-blend-mode:screen;animation:noise .2s steps(2) infinite}.scan-grid{position:absolute;inset:-20%;opacity:.12;background-image:linear-gradient(rgba(100,240,255,.2) 1px,transparent 1px),linear-gradient(90deg,rgba(100,240,255,.2) 1px,transparent 1px);background-size:55px 55px;transform:perspective(600px) rotateX(58deg) scale(1.25);transform-origin:center bottom}.scan-sweep{position:absolute;left:-10%;right:-10%;top:-8%;height:2px;background:linear-gradient(90deg,transparent,#dfffff,transparent);box-shadow:0 0 20px var(--cyan);opacity:.7;animation:scan 3s linear infinite}.intro-top,.intro-footer{position:absolute;left:24px;right:24px;display:flex;justify-content:space-between;font-size:7px;letter-spacing:.22em;color:#638d94}.intro-top{top:20px}.intro-footer{bottom:18px}.intro-core{text-align:center;position:relative;z-index:2;animation:rise .9s ease both}.sigil{font-size:62px;color:var(--cyan);text-shadow:0 0 30px var(--cyan);animation:pulse 2.4s ease-in-out infinite}.eyebrow{font-size:8px;letter-spacing:.3em;color:#6b9aa1;margin-top:3px}h1{font-size:clamp(48px,8vw,105px);margin:5px 0;letter-spacing:.15em;font-weight:950;text-shadow:0 0 20px rgba(255,255,255,.6),0 0 55px rgba(0,220,255,.25)}h1 b{color:var(--cyan)}.subtitle{font-size:clamp(10px,1.4vw,17px);font-weight:800;letter-spacing:.45em;color:#dffcff}.system{display:inline-flex;gap:8px;align-items:center;margin-top:13px;padding:7px 11px;border:1px solid rgba(140,240,255,.2);border-radius:999px;background:rgba(5,15,20,.58);font-size:8px;letter-spacing:.14em;color:#79cbd4}.system i{width:5px;height:5px;border-radius:50%;background:#72ffff;box-shadow:0 0 12px #72ffff}.device-time{margin:16px auto 0;display:flex;flex-direction:column;gap:3px;width:max-content;padding:8px 14px;border:1px solid rgba(120,240,255,.18);border-radius:12px;background:rgba(2,10,14,.55);box-shadow:inset 0 0 18px rgba(0,220,255,.035)}.device-time span{font-size:9px;letter-spacing:.16em;color:#83b8bf}.device-time b{font-size:20px;letter-spacing:.12em;text-shadow:0 0 12px rgba(120,245,255,.5)}.device-time small{font-size:6px;letter-spacing:.2em;color:#50777e}.brief-grid{display:flex;justify-content:center;gap:7px;margin:15px auto 0}.brief-grid div{min-width:130px;padding:8px 10px;border:1px solid rgba(120,240,255,.12);background:rgba(0,0,0,.18);border-radius:9px}.brief-grid small{display:block;font-size:6px;letter-spacing:.18em;color:#5f9299}.brief-grid strong{font-size:8px;letter-spacing:.08em}.intro-core button,.result-actions button{margin-top:20px;padding:13px 24px;border:1px solid rgba(170,250,255,.5);border-radius:14px;background:linear-gradient(135deg,rgba(13,53,64,.9),rgba(2,10,14,.96));color:#efffff;font-weight:850;letter-spacing:.13em;cursor:pointer;box-shadow:0 0 30px rgba(0,220,255,.12),inset 0 0 20px rgba(0,220,255,.05);transition:.2s}.intro-core button:hover,.result-actions button:hover{transform:translateY(-2px);border-color:#fff;box-shadow:0 0 40px rgba(0,220,255,.25)}.intro-core button span{margin-left:18px}.hint{margin-top:13px;font-size:7px;letter-spacing:.12em;color:#55777d}.glass{background:var(--glass);border:1px solid rgba(145,240,255,.2);border-radius:14px;backdrop-filter:blur(11px);box-shadow:0 8px 28px rgba(0,0,0,.25),inset 0 0 20px rgba(0,220,255,.03)}#hud{position:absolute;inset:0;z-index:10;pointer-events:none}.hud-left,.hud-right{position:absolute;top:16px;display:flex;gap:9px}.hud-left{left:16px}.hud-right{right:16px}.health{width:220px;padding:10px}.label-row{display:flex;justify-content:space-between;font-size:8px;letter-spacing:.14em;color:#77b9c2}.label-row b{color:#efffff}.meter,.submeter{height:5px;background:#0e2025;border-radius:9px;overflow:hidden;margin-top:6px}.meter i,.submeter i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#5ffaff,#d9ffff);box-shadow:0 0 12px #00eaff;transition:width .18s}.submeter{height:2px;margin-top:4px}.submeter i{background:#6e9cff;box-shadow:0 0 8px #6e9cff}.stat{padding:10px 15px;min-width:70px}.stat span{display:block;font-size:8px;letter-spacing:.18em;color:#77b9c2;margin-bottom:5px}.stat b{font-size:20px}.hud-center{position:absolute;top:13px;left:50%;transform:translateX(-50%);text-align:center}.sector{font-size:8px;letter-spacing:.18em;color:#6aaeb8}.hud-center #timer{font-size:29px;font-weight:950;letter-spacing:.1em;text-shadow:0 0 12px rgba(255,255,255,.4)}#lock{font-size:8px;letter-spacing:.16em;color:#62eaf5;margin-top:2px}.mission-strip{display:flex;justify-content:center;gap:5px;margin-top:7px}.mission-strip span{padding:3px 6px;border:1px solid rgba(120,240,255,.12);border-radius:6px;background:rgba(0,0,0,.18);font-size:6px;letter-spacing:.12em;color:#5d929a}.mission-strip b{color:#d9ffff}.weapon{padding:9px 13px;text-align:right;min-width:155px}.weapon small{display:block;font-size:8px;letter-spacing:.17em;color:#7db6bd}.weapon strong{font-size:25px}.weapon em{font-style:normal;color:#54838b;margin:0 3px}.weapon label{display:block;font-size:7px;letter-spacing:.15em;color:#65dbe5;margin-top:2px}.intel{position:absolute;left:16px;bottom:16px;display:flex;gap:9px;padding:9px 11px}.intel div{display:flex;flex-direction:column;gap:3px;min-width:73px}.intel span{font-size:6px;letter-spacing:.15em;color:#61949c}.intel b{font-size:8px;letter-spacing:.07em;color:#dffcff}.damage-dir{position:absolute;left:50%;top:30%;transform:translate(-50%,-50%);font-size:32px;color:var(--red);text-shadow:0 0 20px var(--red);animation:warning .4s ease}.toast-stack{position:absolute;right:18px;top:110px;display:flex;flex-direction:column;gap:6px;align-items:flex-end}.toast{padding:8px 11px;border:1px solid rgba(130,240,255,.2);background:rgba(3,12,16,.8);border-radius:9px;font-size:7px;letter-spacing:.12em;animation:toast 2.5s ease both}.toast.warn{border-color:rgba(255,100,120,.5);color:#ffd9de}.pause-badge{position:absolute;inset:0;display:grid;place-items:center;text-align:center;background:rgba(0,4,7,.52);font-size:28px;font-weight:900;letter-spacing:.2em;color:#dfffff;text-shadow:0 0 20px var(--cyan);pointer-events:auto}.pause-badge small{font-size:8px;letter-spacing:.18em;color:#6f9ba2}.rating{font-size:58px;font-weight:950;color:var(--cyan);text-shadow:0 0 30px var(--cyan);margin:5px}.result-card{text-align:center;width:min(760px,92vw);padding:34px;border:1px solid rgba(160,250,255,.25);border-radius:25px;background:linear-gradient(145deg,rgba(7,25,31,.9),rgba(2,8,12,.94));box-shadow:0 30px 100px rgba(0,0,0,.5),inset 0 0 40px rgba(0,220,255,.035);backdrop-filter:blur(18px);animation:rise .7s ease both}.result-line{font-size:8px;letter-spacing:.28em;color:#69cbd5}.result-card h2{font-size:clamp(35px,6vw,66px);letter-spacing:.12em;margin:7px 0;text-shadow:0 0 25px rgba(0,230,255,.35)}.result-card p{font-size:9px;letter-spacing:.2em;color:#79aeb5}.result-stats{display:flex;justify-content:center;flex-wrap:wrap;gap:18px;margin-top:12px;font-size:7px;letter-spacing:.16em;color:#71aeb6}.result-stats b{font-size:18px;color:#efffff;margin-left:5px}.report-bars{display:grid;gap:7px;margin:18px auto;max-width:520px;text-align:left}.report-bars div{display:grid;grid-template-columns:75px 1fr;align-items:center;gap:8px;font-size:6px;letter-spacing:.14em;color:#67949b}.report-bars i{display:block;height:5px;width:0;background:linear-gradient(90deg,#5ffaff,#d9ffff);border-radius:9px;box-shadow:0 0 10px #00eaff;transition:width .7s ease}.result-actions{display:flex;justify-content:center;gap:8px}.result-actions button{margin-top:4px}.result-actions button:last-child{background:rgba(3,12,16,.7);color:#91b2b7}.result-actions button:last-child:hover{box-shadow:none}#crosshair{position:absolute;z-index:9;left:50%;top:50%;width:28px;height:28px;transform:translate(-50%,-50%);pointer-events:none}#crosshair:before,#crosshair:after,#crosshair i,#crosshair b{content:"";position:absolute;background:#dfffff;box-shadow:0 0 9px var(--cyan)}#crosshair:before{width:2px;height:9px;left:13px;top:0}#crosshair:after{width:2px;height:9px;left:13px;bottom:0}#crosshair i{height:2px;width:9px;top:13px;left:0}#crosshair b{height:2px;width:9px;top:13px;right:0}#crosshair span{position:absolute;inset:11px;border:1px solid var(--cyan);border-radius:50%}#controls{position:absolute;z-index:12;left:18px;bottom:22px;display:flex;flex-direction:column;align-items:center;gap:3px}#controls button,#fire{width:48px;height:42px;border-radius:12px;border:1px solid rgba(160,245,255,.35);background:rgba(4,18,23,.72);color:#dffcff;font-weight:800;backdrop-filter:blur(8px)}#fire{position:absolute;z-index:12;right:24px;bottom:27px;width:82px;height:82px;border-radius:50%;color:#dfffff;border-color:rgba(120,240,255,.55);box-shadow:0 0 25px rgba(0,220,255,.12);font-size:9px;line-height:1.15}#fire small{font-size:6px;letter-spacing:.1em;opacity:.7}#fire:active{transform:scale(.94)}#weaponView{position:absolute;z-index:8;right:6%;bottom:-22px;width:360px;height:220px;pointer-events:none;filter:drop-shadow(0 14px 18px rgba(0,0,0,.8))}.weapon-body{position:absolute;right:15px;bottom:45px;width:220px;height:48px;background:linear-gradient(145deg,#252b30,#080b0d);border:2px solid #52646b;border-radius:8px 20px 10px 5px;transform:rotate(-8deg);box-shadow:inset 0 0 18px #000}.weapon-barrel{position:absolute;right:0;bottom:87px;width:175px;height:12px;background:#101416;border:2px solid #56666b;border-radius:3px;transform:rotate(-8deg)}.weapon-sight{position:absolute;right:118px;bottom:102px;width:36px;height:10px;border:2px solid #5c7277;border-bottom:0;transform:rotate(-8deg)}.hero-arm{position:absolute;width:135px;height:68px;background:linear-gradient(145deg,#1d2a30,#080d11);border:2px solid #3c5a62;border-radius:60% 22% 12% 18%;box-shadow:inset 0 0 16px #000}.arm-a{right:105px;bottom:7px;transform:rotate(-10deg)}.arm-b{right:35px;bottom:28px;transform:rotate(15deg);width:120px}.weapon-label{position:absolute;right:130px;bottom:22px;font-size:7px;letter-spacing:.16em;color:#8eeef5;text-shadow:0 0 8px #00eaff;opacity:.75}.firing .weapon-barrel{box-shadow:0 0 16px rgba(220,255,255,.7)}@keyframes rise{from{opacity:0;transform:translateY(16px) scale(.98)}to{opacity:1;transform:none}}@keyframes pulse{50%{transform:scale(1.05);text-shadow:0 0 35px var(--cyan)}}@keyframes scan{0%{transform:translateY(0);opacity:0}10%{opacity:.6}90%{opacity:.35}100%{transform:translateY(115vh);opacity:0}}@keyframes noise{0%{transform:translate(0)}50%{transform:translate(2px,-1px)}100%{transform:translate(-1px,1px)}}@keyframes warning{0%,100%{opacity:.2}50%{opacity:1;transform:translate(-50%,-50%) scale(1.15)}}@keyframes toast{0%{opacity:0;transform:translateX(15px)}12%,75%{opacity:1;transform:none}100%{opacity:0;transform:translateX(15px)}}@media(max-width:700px){.brief-grid div{min-width:0}.brief-grid strong{font-size:7px}.health{width:155px}.stat{display:none}.weapon{min-width:130px}.hud-center{top:9px}.hud-left,.hud-right{top:9px}.hud-center .sector{display:none}.intel{left:9px;bottom:9px;gap:5px;padding:7px}.intel div{min-width:53px}.intel div:nth-child(3),.intel div:nth-child(5){display:none}.mission-strip span:nth-child(3){display:none}.hint{display:none}.intro-top,.intro-footer{left:10px;right:10px}.result-card{padding:24px 16px}.result-actions{flex-direction:column}.result-actions button{width:100%}#weaponView{right:-65px;bottom:-35px;transform:scale(.7);transform-origin:bottom right}.weapon-label{right:110px;bottom:20px}.toast-stack{top:92px;right:9px}.device-time{margin-top:12px}}

/* ECHO CITY X // UX expansion layer — preserves the original visual language */
.overlay-modal{position:absolute;inset:0;z-index:40;display:grid;place-items:center;background:rgba(1,6,9,.62);backdrop-filter:blur(8px);padding:20px}.overlay-modal.hidden{display:none}.modal-card,.pause-card{width:min(720px,94vw);padding:28px;border:1px solid rgba(160,250,255,.25);border-radius:24px;background:linear-gradient(145deg,rgba(7,25,31,.95),rgba(2,8,12,.97));box-shadow:0 30px 100px rgba(0,0,0,.58),inset 0 0 40px rgba(0,220,255,.035);backdrop-filter:blur(18px);text-align:center;animation:rise .35s ease both}.modal-kicker{font-size:8px;letter-spacing:.24em;color:#69cbd5}.modal-card h2,.pause-card h2{font-size:clamp(28px,5vw,48px);letter-spacing:.12em;margin:7px 0;text-shadow:0 0 22px rgba(0,230,255,.32)}.modal-card p{max-width:580px;margin:0 auto;color:#78aab1;font-size:9px;line-height:1.7;letter-spacing:.06em}.difficulty-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:18px 0 12px}.difficulty-option{min-height:135px;padding:14px 10px;border:1px solid rgba(120,240,255,.16);border-radius:14px;background:rgba(2,13,17,.68);color:#dffcff;text-align:left;cursor:pointer;transition:.2s}.difficulty-option:hover,.difficulty-option.selected{transform:translateY(-3px);border-color:rgba(130,250,255,.75);box-shadow:0 0 28px rgba(0,220,255,.12),inset 0 0 22px rgba(0,220,255,.04)}.difficulty-option b{display:block;font-size:17px;letter-spacing:.12em}.difficulty-option span{display:block;margin-top:4px;font-size:7px;letter-spacing:.18em;color:#65dbe5}.difficulty-option small{display:block;margin-top:14px;color:#6e989f;font-size:7px;line-height:1.5;letter-spacing:.05em}.difficulty-meta{display:flex;justify-content:space-between;color:#5e8f97;font-size:7px;letter-spacing:.15em}.difficulty-meta b{color:#dffcff}.modal-primary,.modal-secondary{display:block;width:100%;padding:12px 18px;border-radius:13px;cursor:pointer;font-weight:850;letter-spacing:.13em}.modal-primary{margin-top:15px;border:1px solid rgba(170,250,255,.5);background:linear-gradient(135deg,rgba(13,53,64,.9),rgba(2,10,14,.96));color:#efffff;box-shadow:0 0 30px rgba(0,220,255,.1)}.modal-secondary{margin-top:7px;border:1px solid rgba(120,240,255,.12);background:rgba(3,12,16,.7);color:#79aab1}.pause-button{position:absolute;z-index:13;left:18px;bottom:128px;width:48px;height:48px;padding:0;border:1px solid rgba(145,240,255,.35);border-radius:12px;background:rgba(3,13,17,.78);color:#dffcff;pointer-events:auto;cursor:pointer;backdrop-filter:blur(10px);box-shadow:0 0 18px rgba(0,220,255,.08)}
.pause-icon{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;height:100%}.pause-icon i{display:block;width:5px;height:20px;border-radius:2px;background:#dffcff;box-shadow:0 0 8px rgba(114,247,255,.55)}.pause-button:active{transform:scale(.94)}.pause-button.hidden{display:none}.pause-overlay{position:absolute;inset:0;z-index:35;display:grid;place-items:center;background:rgba(0,4,7,.62);backdrop-filter:blur(10px);pointer-events:auto}.pause-overlay.hidden{display:none}.pause-card{width:min(560px,92vw)}.pause-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:15px 0}.pause-tab{padding:9px 4px;border:1px solid rgba(120,240,255,.12);border-radius:9px;background:rgba(0,0,0,.2);color:#6d9da4;font-size:7px;letter-spacing:.15em;cursor:pointer}.pause-tab.active{color:#eaffff;border-color:rgba(130,250,255,.55);box-shadow:inset 0 0 18px rgba(0,220,255,.06)}.pause-panel{display:none;min-height:76px;text-align:left;padding:12px;border:1px solid rgba(120,240,255,.1);border-radius:12px;background:rgba(0,0,0,.16)}.pause-panel.active{display:block}.pause-panel label{display:flex;align-items:center;gap:15px;justify-content:space-between;font-size:7px;letter-spacing:.15em;color:#8bc2c8}.pause-panel input[type=range]{width:55%;accent-color:#6ff7ff}.setting-button,.quality-btn{padding:8px 10px;border:1px solid rgba(120,240,255,.18);border-radius:8px;background:rgba(2,12,16,.72);color:#bfeef2;font-size:7px;letter-spacing:.1em;cursor:pointer}.setting-button{margin-top:12px}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:7px;letter-spacing:.14em;color:#8bc2c8}.quality-btn.active{border-color:rgba(130,250,255,.6);color:#efffff;box-shadow:0 0 15px rgba(0,220,255,.1)}.setting-note{display:block;margin-top:12px;color:#628e95;font-size:7px;line-height:1.6}.filters-off .noise,.filters-off .scan-grid,.filters-off .scan-sweep{display:none}.filters-off #game{filter:none}.performance-mode #game{image-rendering:auto}.performance-mode .noise,.performance-mode .scan-grid{opacity:.35}.performance-mode #weaponView{filter:none}.performance-mode .glass{backdrop-filter:none}.firing .weapon-body{box-shadow:inset 0 0 18px #000,0 0 22px rgba(210,250,255,.28)}
.intro-actions{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px}
.ghost-btn{margin-top:20px;padding:13px 20px;border:1px solid rgba(120,240,255,.28);border-radius:14px;background:rgba(3,13,17,.55);color:#bdeef2;font-weight:800;letter-spacing:.12em;cursor:pointer;display:inline-flex;align-items:center;gap:9px;transition:.2s}
.ghost-btn:hover{border-color:#fff;color:#fff;box-shadow:0 0 22px rgba(0,220,255,.15);transform:translateY(-2px)}
.ghost-btn .gear{width:11px;height:11px;border:2px solid currentColor;border-radius:50%;position:relative;display:inline-block}
.ghost-btn .gear::before{content:"";position:absolute;inset:-4px;border:2px dashed currentColor;border-radius:50%;opacity:.6;animation:spinGear 6s linear infinite}
@keyframes spinGear{to{transform:rotate(360deg)}}
.quality-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}
.quality-grid .quality-btn{padding:10px 4px}
.gfx-low .noise,.gfx-low .scan-grid{display:none}
.gfx-low .glass{backdrop-filter:none}
.gfx-medium .noise{opacity:.4}
@media(max-width:700px){.quality-grid{grid-template-columns:repeat(2,1fr)}.pause-tabs{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.difficulty-grid{grid-template-columns:1fr}.difficulty-option{min-height:88px}.difficulty-option small{margin-top:7px}.pause-button{right:9px;bottom:9px}.pause-card{padding:20px 14px}}
/* ECHO CITY + // combat readability + score reveal */
#fire{width:92px;height:92px;font-size:25px;font-weight:950;border-width:2px;box-shadow:0 0 30px rgba(0,220,255,.18),inset 0 0 18px rgba(0,220,255,.08)}
#fire small{font-size:7px;letter-spacing:.18em}
#fire::after{content:'KEY F';display:block;margin-top:3px;font-size:6px;letter-spacing:.18em;color:#71aeb6}
.result-stats span:nth-child(2){position:relative}
.result-stats .score-highlight{padding:10px 18px;border:1px solid rgba(114,247,255,.7);border-radius:13px;background:rgba(0,220,255,.08);box-shadow:0 0 35px rgba(0,220,255,.22),inset 0 0 22px rgba(0,220,255,.06);transform:scale(1.12);animation:scorePulse 1.1s ease-in-out infinite}
.result-stats .score-highlight b{font-size:30px;color:#fff;text-shadow:0 0 18px var(--cyan)}
.result-stats .score-highlight::before{content:'FINAL SCORE';display:block;color:var(--cyan);font-size:7px;letter-spacing:.22em;margin-bottom:2px}
@keyframes scorePulse{50%{box-shadow:0 0 55px rgba(0,220,255,.42),inset 0 0 30px rgba(0,220,255,.1)}}
@media(max-width:700px){#fire{width:84px;height:84px}.result-stats .score-highlight{transform:scale(1.05)}}

.giant-warning{position:absolute;z-index:25;top:16%;left:50%;transform:translateX(-50%);text-align:center;pointer-events:none;animation:giantWarn .22s ease-in-out infinite alternate}.giant-warning.hidden{display:none}.warning-symbol{font-size:48px;line-height:1;color:#ff6578;text-shadow:0 0 8px #ff203f,0 0 26px rgba(255,40,70,.8)}.warning-text{margin-top:5px;padding:6px 12px;border:1px solid rgba(255,101,120,.7);background:rgba(20,0,4,.72);font-size:9px;font-weight:900;letter-spacing:.2em;color:#ffdce0}.giant-warning::after{content:"";position:absolute;left:50%;top:2px;width:90px;height:90px;transform:translateX(-50%);border:1px solid rgba(255,80,100,.35);border-radius:50%;animation:warnRing 1s linear infinite}.giant-enemy-glow{filter:drop-shadow(0 0 10px rgba(255,40,60,.8))}@keyframes giantWarn{from{transform:translateX(-50%) scale(1)}to{transform:translateX(-50%) scale(1.05)}}@keyframes warnRing{to{transform:translateX(-50%) rotate(360deg) scale(1.3);opacity:0}}

.controls-list{display:grid;gap:7px}.controls-list div{display:flex;justify-content:space-between;gap:18px;padding:7px 8px;border-bottom:1px solid rgba(120,240,255,.08);font-size:7px;letter-spacing:.08em}.controls-list b{color:#eaffff}.controls-list span{color:#7daeb5;text-align:right}
.speed-boost{position:absolute;z-index:12;left:18px;bottom:72px;width:48px;height:42px;border-radius:12px;border:1px solid rgba(160,245,255,.35);background:rgba(4,18,23,.72);color:#dffcff;font-weight:900;backdrop-filter:blur(8px)}.speed-boost small{display:block;font-size:5px;letter-spacing:.08em;opacity:.7}.speed-boost:active{transform:scale(.94)}
/* ECX 2.1 layout/debug reinforcement */
.pause-button{position:absolute!important;left:18px!important;right:auto!important;bottom:18px!important;width:48px!important;height:48px!important;z-index:40!important;border-radius:12px!important}
.pause-icon{display:flex;gap:5px;align-items:center;justify-content:center}
.pause-icon i{display:block;width:4px;height:17px;border-radius:2px;background:#dffcff;box-shadow:0 0 8px rgba(114,247,255,.45)}
.giant-warning{pointer-events:none}
.giant-warning .warning-symbol{font-size:42px!important;line-height:1;text-shadow:0 0 22px #ff314d,0 0 48px rgba(255,49,77,.7);animation:warningPulse .35s ease-in-out infinite alternate}
@keyframes warningPulse{from{transform:scale(.9);opacity:.65}to{transform:scale(1.12);opacity:1}}
.bottom-status{position:absolute;left:18px;bottom:76px;z-index:13;display:flex;gap:7px;padding:7px 9px;min-width:210px;pointer-events:none}
.bottom-status>div{min-width:58px;padding:4px 6px;border:1px solid rgba(130,240,255,.12);border-radius:7px;background:rgba(3,14,18,.52)}
.bottom-status span{display:block;font-size:6px;letter-spacing:.12em;color:#76aeb6}
.bottom-status b{font-size:10px}
.boost-status b{color:#66ffb1}
#controls{bottom:18px!important}
.speed-boost{left:18px!important;bottom:130px!important}
#fire{bottom:20px!important}

/* ECHO CITY X enhancement layer */
.combo-hud{min-width:86px;position:relative;overflow:hidden}.combo-hud b{font-size:20px}.combo-hud small{display:block;color:var(--cyan);font-size:8px;letter-spacing:.12em}.combo-hud.hot{box-shadow:0 0 22px rgba(255,101,120,.28);border-color:rgba(255,101,120,.55)}#tacticalPulse{position:absolute;right:20px;bottom:118px;z-index:22;width:64px;height:64px;border:1px solid rgba(114,247,255,.55);border-radius:50%;background:rgba(4,15,20,.82);color:#dfffff;font-weight:900;font-size:18px;box-shadow:0 0 24px rgba(114,247,255,.16);backdrop-filter:blur(8px)}#tacticalPulse small{display:block;font-size:7px;letter-spacing:.12em;color:var(--cyan)}#tacticalPulse.ready{animation:pulseReady 1.6s ease-in-out infinite}@keyframes pulseReady{50%{transform:scale(1.05);box-shadow:0 0 30px rgba(114,247,255,.35)}}.pickup-glow{filter:drop-shadow(0 0 8px rgba(114,247,255,.7))}
@media(max-width:700px){#tacticalPulse{right:18px;bottom:154px;width:58px;height:58px}.intel{top:165px!important;right:10px!important;left:auto!important;max-width:220px}.combo-hud{min-width:72px}}

#controls{position:absolute;z-index:22;left:20px;bottom:24px;width:128px;height:128px;display:block;touch-action:none;user-select:none;-webkit-user-select:none}
.joystick-base{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(225,255,255,.78);background:radial-gradient(circle,rgba(114,247,255,.18),rgba(4,18,23,.52) 58%,rgba(2,8,11,.72));box-shadow:0 0 0 7px rgba(255,255,255,.08),0 10px 30px rgba(0,0,0,.35),inset 0 0 22px rgba(114,247,255,.1);backdrop-filter:blur(5px)}
.joystick-base:after{content:"";position:absolute;inset:24px;border:1px solid rgba(255,255,255,.18);border-radius:50%;pointer-events:none}
.joystick-knob{position:absolute;left:50%;top:50%;width:62px;height:62px;margin:-31px 0 0 -31px;border-radius:50%;border:2px solid rgba(240,255,255,.9);background:radial-gradient(circle at 35% 30%,rgba(230,255,255,.42),rgba(57,130,143,.55) 52%,rgba(2,15,20,.82));box-shadow:0 5px 18px rgba(0,0,0,.42),inset 0 0 12px rgba(114,247,255,.22);pointer-events:none;will-change:transform}
#fire{right:22px;bottom:25px;width:94px;height:94px;border-radius:50%;font-size:11px;touch-action:manipulation;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}
@media(max-width:700px){
  #controls{left:18px;bottom:22px;width:132px;height:132px}
  #fire{right:20px;bottom:24px;width:94px;height:94px}
  #weaponView{display:none!important}
  .bottom-status{display:none}
}
@media(max-width:420px){
  #controls{left:14px;bottom:16px;width:116px;height:116px}
  .joystick-knob{width:56px;height:56px;margin:-28px 0 0 -28px}
  #fire{right:16px;bottom:18px;width:84px;height:84px}
}


/* ECX PERFORMANCE-FIRST MOBILE UI */
html,body,#app{
  width:100%;
  height:100%;
  height:100dvh;
  min-height:100%;
  overflow:hidden;
  overscroll-behavior:none;
}
body{touch-action:none;overscroll-behavior:none}
#game{width:100%;height:100%;touch-action:none}

/* Pause: fixed top-left, compact and visually quiet */
.pause-button{
  top:10px!important;
  left:10px!important;
  right:auto!important;
  bottom:auto!important;
  width:46px!important;
  height:46px!important;
  border-radius:12px!important;
  background:rgba(3,13,17,.58)!important;
  border-color:rgba(145,240,255,.20)!important;
  box-shadow:0 0 10px rgba(0,220,255,.04)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
.pause-icon i{
  width:4px!important;
  height:18px!important;
  box-shadow:none!important;
}
.hud-left{left:66px!important;top:10px!important}
.hud-right{right:10px!important;top:10px!important}

/* Make all touch controls subtle rather than attention-grabbing */
#controls{
  left:14px!important;
  bottom:14px!important;
  width:116px!important;
  height:116px!important;
  opacity:.72;
}
.joystick-base{
  background:rgba(4,17,22,.34)!important;
  border-color:rgba(145,240,255,.18)!important;
  box-shadow:none!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
.joystick-base:after{border-color:rgba(255,255,255,.10)!important}
.joystick-knob{
  width:54px!important;height:54px!important;
  margin:-27px 0 0 -27px!important;
  background:radial-gradient(circle at 35% 30%,rgba(230,255,255,.28),rgba(57,130,143,.34) 52%,rgba(2,15,20,.62))!important;
  box-shadow:none!important;
}
#fire{
  right:14px!important;
  bottom:14px!important;
  width:82px!important;
  height:82px!important;
  opacity:.70;
  background:rgba(4,18,23,.42)!important;
  box-shadow:none!important;
  border-color:rgba(114,247,255,.22)!important;
}
#tacticalPulse{
  right:12px!important;
  bottom:108px!important;
  width:52px!important;
  height:52px!important;
  opacity:.55;
  box-shadow:none!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
.speed-boost{
  left:12px!important;
  bottom:118px!important;
  opacity:.55;
  box-shadow:none!important;
}

/* Keep gameplay HUD readable but visually quieter */
.glass{
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
  box-shadow:0 5px 16px rgba(0,0,0,.18),inset 0 0 12px rgba(0,220,255,.018)!important;
}
.mission-strip span,
.bottom-status>div{
  background:rgba(0,0,0,.12)!important;
}
.bottom-status{opacity:.72}

/* Result screen: fit the entire mission report in landscape fullscreen */
#result{
  overflow:auto!important;
  overscroll-behavior:contain!important;
  padding:
    max(10px,env(safe-area-inset-top))
    max(10px,env(safe-area-inset-right))
    max(10px,env(safe-area-inset-bottom))
    max(10px,env(safe-area-inset-left));
  box-sizing:border-box;
  place-items:center;
}
.result-card{
  width:min(720px,94vw)!important;
  max-height:calc(100dvh - 20px)!important;
  overflow:auto!important;
  box-sizing:border-box;
  padding:20px!important;
  scrollbar-width:none;
}
.result-card::-webkit-scrollbar{display:none}
.result-card h2{font-size:clamp(30px,5vw,56px)!important}
.result-stats{gap:10px!important;margin-top:8px!important}
.result-stats b{font-size:16px!important}
.report-bars{gap:5px!important;margin:10px auto!important}
.result-actions{
  display:grid!important;
  grid-template-columns:1fr 1fr;
  gap:8px!important;
  margin-top:6px;
}
.result-actions button{
  margin-top:0!important;
  min-height:42px;
  padding:10px 12px!important;
  box-shadow:none!important;
}
@media(max-height:520px) and (orientation:landscape){
  .result-card{
    max-height:calc(100dvh - 12px)!important;
    padding:12px 16px!important;
  }
  .result-line{font-size:7px!important}
  .result-card h2{font-size:30px!important;margin:3px 0!important}
  .result-card p{font-size:8px!important;margin:3px 0!important}
  .rating{font-size:30px!important}
  .result-stats{gap:7px!important;font-size:6px!important}
  .result-stats b{font-size:14px!important}
  .report-bars{margin:6px auto!important}
  .result-actions button{min-height:38px!important;padding:8px 10px!important}
}

/* Settings / pause panels: consistent alignment */
.pause-card,.modal-card{
  box-sizing:border-box;
}
.pause-tabs{
  gap:5px!important;
}
.pause-tab,.setting-button,.quality-btn{
  min-height:36px;
  display:flex!important;
  align-items:center;
  justify-content:center;
  text-align:center;
}
.quality-grid{gap:7px!important}
.setting-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}
.controls-list>div{
  display:grid!important;
  grid-template-columns:minmax(95px,1fr) minmax(120px,1.5fr)!important;
  align-items:center;
  gap:10px!important;
  padding:7px 0!important;
}
@media(max-width:700px){
  .hud-left .health{width:145px!important}
  .hud-right .weapon{min-width:132px!important}
  .pause-card{width:min(620px,94vw)!important;padding:16px!important}
  .pause-tabs{grid-template-columns:repeat(4,1fr)!important}
}
@media(max-width:520px){
  .pause-tabs{grid-template-columns:repeat(2,1fr)!important}
  .hud-left{left:62px!important}
}


/* ECX PRO POLISH // dark-only climate + compact power rail */
.result-logo{width:58px;height:58px;margin:0 auto 8px;border-radius:50%;overflow:hidden;border:1px solid rgba(114,247,255,.35);box-shadow:0 0 18px rgba(0,210,255,.12)}.result-logo img{width:100%;height:100%;object-fit:cover}.logo-wrap{width:126px;height:126px;margin:0 auto 10px;border-radius:50%;overflow:hidden;border:1px solid rgba(114,247,255,.48);background:#02070a;box-shadow:0 0 24px rgba(0,210,255,.18),inset 0 0 18px rgba(0,0,0,.8);position:relative}
.intro-logo{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transform:scale(1.02)}
.power-rail{display:flex;align-items:center;justify-content:center;gap:6px;margin:7px auto 0;pointer-events:auto}
.power-btn{width:62px;height:46px;padding:4px 5px;border:1px solid rgba(114,247,255,.18);border-radius:11px;background:rgba(2,9,12,.70);color:#dffcff;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;transition:transform .08s,border-color .12s,opacity .12s}
.power-btn b{font-size:15px;letter-spacing:.02em}.power-btn small{font-size:5px;letter-spacing:.11em;color:#75aeb6;margin-top:3px}.power-btn em{font-style:normal;font-size:5px;letter-spacing:.09em;color:#66ffb1;margin-top:3px}.power-btn:active{transform:scale(.94)}.power-btn.ready{border-color:rgba(114,247,255,.38)}.power-btn.cooling{opacity:.45;border-color:rgba(114,247,255,.10)}.time-plus b{color:#72f7ff}.speed-health b{color:#66ffb1}.combo-display{pointer-events:none}.combo-display.hot{border-color:rgba(255,101,120,.45);box-shadow:none}.combo-display b{font-size:16px;color:#fff}
/* Dark-only gameplay palette. No alternate climate/filter looks. */
body.filters-off .scan-grid,body.filters-off .noise{display:none!important}
body.filters-off #game{background:#02070a!important}
body.filters-off .glass{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.pause-tabs{grid-template-columns:repeat(3,1fr)!important}
.controls-list div{grid-template-columns:110px 1fr!important;display:grid!important;align-items:center}
.pause-card,.modal-card{background:linear-gradient(145deg,rgba(3,12,16,.97),rgba(1,5,8,.99))!important;border-color:rgba(114,247,255,.16)!important;box-shadow:0 24px 80px rgba(0,0,0,.62),inset 0 0 28px rgba(0,190,220,.018)!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.pause-tab,.quality-btn,.setting-button{background:rgba(2,9,12,.78)!important;box-shadow:none!important}
.pause-tab.active,.quality-btn.active{border-color:rgba(114,247,255,.48)!important;background:rgba(8,30,36,.9)!important}
.result-card{background:linear-gradient(145deg,rgba(3,12,16,.98),rgba(1,5,8,.99))!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.result-actions button,.intro-core button{box-shadow:0 0 16px rgba(0,190,220,.08),inset 0 0 14px rgba(0,190,220,.025)!important}
@media(max-width:700px){
  .logo-wrap{width:94px;height:94px;margin-bottom:7px}
  .power-rail{gap:4px;margin-top:5px}
  .power-btn{width:58px;height:42px}
  .hud-center #timer{font-size:27px}
  .hud-left{left:66px!important;gap:5px!important}.health{width:145px!important}.stat{min-width:55px!important;padding:9px 10px!important}
}
@media(max-height:520px) and (orientation:landscape){
  .logo-wrap{width:76px;height:76px;margin-bottom:4px}.intro-core{transform:scale(.88)}.brief-grid{margin-top:7px}.device-time{margin-top:7px}.intro-core button{margin-top:9px;padding:10px 18px}.hint{margin-top:7px}
  .power-btn{height:39px}.power-rail{margin-top:3px}.hud-center{top:8px!important}.mission-strip{margin-top:4px!important}
}
/* Joystick: responsive inner circle can travel beyond the outer ring, with immediate response. */
.joystick-base{overflow:visible!important}.joystick-knob{transition:none!important;will-change:transform}.joystick-base:after{inset:27px!important}


/* ECX 2.2 MOBILE HUD ALIGNMENT */
.hud-left{
  left:74px!important;
  top:12px!important;
  align-items:stretch!important;
  gap:6px!important;
  z-index:16!important;
}
.health{width:190px!important;padding:8px 10px!important}
.compact-stat{
  min-width:58px!important;
  width:58px!important;
  padding:8px 7px!important;
  text-align:center!important;
}
.compact-stat span{font-size:6px!important;margin-bottom:4px!important}
.compact-stat b{font-size:17px!important;line-height:1!important}
.alive-stat b{color:#66ffb1!important}

/* Pause is always top-left and shares the same compact visual language. */
.pause-button{
  position:absolute!important;
  left:12px!important;
  top:12px!important;
  right:auto!important;
  bottom:auto!important;
  width:48px!important;
  height:48px!important;
  z-index:40!important;
  background:rgba(3,13,18,.72)!important;
  border:1px solid rgba(145,240,255,.22)!important;
  box-shadow:none!important;
}

/* Health / Armor / Speed / Shield now sit directly under Player Integrity. */
.bottom-status{
  left:74px!important;
  top:76px!important;
  bottom:auto!important;
  min-width:190px!important;
  width:190px!important;
  display:grid!important;
  grid-template-columns:repeat(4,1fr)!important;
  gap:4px!important;
  padding:5px!important;
  z-index:15!important;
  opacity:.78!important;
  pointer-events:none!important;
}
.bottom-status>div{
  min-width:0!important;
  padding:4px 3px!important;
  text-align:center!important;
  background:rgba(3,14,18,.46)!important;
}
.bottom-status span{font-size:5px!important}
.bottom-status b{font-size:8px!important}

/* Keep the map clear of the new upper-left stat cluster. Canvas is drawn higher in JS. */

/* Compact, understandable proximity indicator on the right. */
.proximity-hud{
  position:absolute;
  right:16px;
  top:94px;
  z-index:16;
  min-width:112px;
  padding:7px 9px;
  border:1px solid rgba(145,240,255,.18);
  border-radius:9px;
  background:rgba(3,13,18,.66);
  color:#dffcff;
  text-align:center;
  pointer-events:none;
  box-shadow:none;
}
.proximity-hud span{display:block;font-size:5px;letter-spacing:.13em;color:#6f9da4}
.proximity-hud b{display:block;margin-top:3px;font-size:9px;letter-spacing:.1em;color:#dffcff}

/* Weapon/ammo dock: above and left of Fire, with ammo directly beneath the gun. */
.weapon-dock{
  position:absolute;
  right:112px;
  bottom:116px;
  z-index:17;
  width:126px;
  padding:7px 8px 6px;
  border:1px solid rgba(145,240,255,.16);
  border-radius:10px;
  background:rgba(3,13,18,.62);
  pointer-events:none;
  text-align:center;
  box-shadow:none;
}
.weapon-mini-gun{
  position:relative;
  width:92px;
  height:25px;
  margin:0 auto 3px;
  transform:rotate(-7deg);
}
.weapon-mini-gun i,.weapon-mini-gun b,.weapon-mini-gun em{position:absolute;display:block;background:#9ab5b9;border:1px solid #456067}
.weapon-mini-gun i{left:10px;top:8px;width:58px;height:9px;border-radius:4px}
.weapon-mini-gun b{right:4px;top:5px;width:25px;height:5px;border-radius:2px}
.weapon-mini-gun em{left:31px;top:15px;width:9px;height:12px;transform:skew(-12deg);border-radius:2px}
.weapon-mini-name{font-size:5px;letter-spacing:.13em;color:#73aeb6;white-space:nowrap}
.weapon-mini-ammo{display:flex;align-items:baseline;justify-content:center;gap:4px;margin-top:2px}
.weapon-mini-ammo strong{font-size:17px;line-height:1;color:#efffff}
.weapon-mini-ammo span{font-size:9px;color:#527b83}
.weapon-mini-ready{font-size:5px;letter-spacing:.12em;color:#66ffb1;margin-top:2px}

/* Make the power rail a quiet, even row beneath the timer. */
.power-rail{gap:4px!important;margin-top:5px!important}
.power-btn{width:56px!important;height:39px!important;border-radius:9px!important;opacity:.78!important}
.power-btn b{font-size:13px!important}
.power-btn small{font-size:4px!important}
.power-btn em{font-size:4px!important}

/* Kills/Alive remain readable without competing with the timer. */
.hud-center{z-index:14!important}
.mission-strip{gap:4px!important}
.mission-strip span{padding:2px 5px!important}

@media(max-width:700px){
  .hud-left{left:68px!important;top:9px!important;gap:4px!important}
  .health{width:150px!important}
  .compact-stat{width:48px!important;min-width:48px!important;padding:7px 4px!important}
  .compact-stat b{font-size:15px!important}
  .bottom-status{left:68px!important;top:68px!important;width:150px!important;min-width:150px!important}
  .proximity-hud{right:9px;top:82px;min-width:96px;padding:6px 7px}
  .weapon-dock{right:103px;bottom:111px;width:112px;padding:6px 6px 5px}
  .weapon-mini-gun{transform:scale(.88) rotate(-7deg);margin-bottom:0}
  .weapon-mini-name{font-size:4px}
  .weapon-mini-ammo strong{font-size:15px}
}
@media(max-width:420px){
  .hud-left{left:62px!important}
  .health{width:132px!important}
  .compact-stat{width:43px!important;min-width:43px!important}
  .bottom-status{left:62px!important;top:65px!important;width:132px!important;min-width:132px!important}
  .proximity-hud{right:7px;top:76px;min-width:88px}
  .weapon-dock{right:92px;bottom:98px;width:104px}
}

/* Intro logo: subtle circular glow, without heavy rendering cost. */
.logo-wrap{position:relative!important;width:118px!important;height:118px!important;margin:0 auto 5px!important;display:grid!important;place-items:center!important;border-radius:50%!important}
.logo-wrap::before,.logo-wrap::after{content:"";position:absolute;inset:0;border-radius:50%;pointer-events:none}
.logo-wrap::before{border:1px solid rgba(114,247,255,.42);box-shadow:0 0 18px rgba(0,220,255,.20),inset 0 0 18px rgba(0,220,255,.07);animation:logoRing 2.8s ease-in-out infinite}
.logo-wrap::after{inset:8px;border:1px solid rgba(114,247,255,.18);animation:logoRing2 2.8s linear infinite}
.intro-logo{position:relative;z-index:2;width:88px!important;height:88px!important;object-fit:cover;border-radius:50%!important;filter:drop-shadow(0 0 14px rgba(0,220,255,.32))}
@keyframes logoRing{50%{transform:scale(1.08);opacity:.72}100%{transform:scale(1);opacity:1}}
@keyframes logoRing2{to{transform:rotate(360deg)}}
#enter{animation:deployPulse 1.55s ease-in-out infinite!important}
@keyframes deployPulse{0%,100%{box-shadow:0 0 16px rgba(0,220,255,.12),inset 0 0 14px rgba(0,220,255,.04);transform:scale(1)}50%{box-shadow:0 0 28px rgba(0,220,255,.28),inset 0 0 18px rgba(0,220,255,.07);transform:scale(1.025)}}

@media(max-height:520px) and (orientation:landscape){
  .logo-wrap{width:76px!important;height:76px!important}
  .intro-logo{width:58px!important;height:58px!important}
}


/* ECX // REFERENCE MATCH PASS — tuned to the supplied 1536×688 combat reference */
.top-right-stats{position:absolute;right:20px;top:17px;z-index:18;display:grid;grid-template-columns:1fr 1fr;width:176px;height:74px;padding:0;overflow:hidden;pointer-events:none;background:rgba(3,13,18,.72)}
.top-right-stats>div{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px}
.top-right-stats>div+div{border-left:1px solid rgba(145,240,255,.13)}
.top-right-stats span{font-size:7px;letter-spacing:.2em;color:#77b9c2}.top-right-stats b{font-size:25px;line-height:1;color:#efffff}.top-right-stats>div:last-child b{color:#66ffb1}
.hud-left{left:116px!important;top:18px!important}.hud-left .health{width:352px!important;height:75px!important;padding:12px 22px!important;border-radius:16px!important}
.hud-left .label-row{font-size:10px!important}.hud-left .label-row b{font-size:16px}.hud-left .meter{height:7px!important;margin-top:9px!important}.hud-left .submeter{height:4px!important;margin-top:6px!important}
.bottom-status{left:116px!important;top:101px!important;bottom:auto!important;width:352px!important;min-width:352px!important;height:75px!important;grid-template-columns:repeat(4,1fr)!important;gap:7px!important;padding:9px!important;opacity:1!important;border-radius:16px!important}
.bottom-status>div{padding:7px 5px!important;border-radius:11px!important}.bottom-status span{font-size:7px!important;letter-spacing:.14em!important}.bottom-status b{font-size:16px!important}.bottom-status .boost-status b{font-size:14px!important}
.hud-center{top:17px!important}.hud-center .sector{font-size:10px!important;letter-spacing:.2em!important}.hud-center #timer{font-size:44px!important;line-height:1.02!important;letter-spacing:.1em!important}.hud-center #lock{font-size:10px!important;margin-top:4px!important}.mission-strip{margin-top:8px!important;gap:7px!important}.mission-strip span{padding:5px 10px!important;font-size:7px!important;border-radius:8px!important}
.power-rail{margin-top:8px!important;gap:9px!important}.power-btn{width:120px!important;height:76px!important;border-radius:13px!important}.power-btn b{font-size:21px!important}.power-btn small{font-size:7px!important}.power-btn em{font-size:6px!important}
.weapon-dock{right:130px!important;bottom:204px!important;width:216px!important;height:140px!important;padding:12px 10px 9px!important;border-radius:14px!important}.weapon-mini-gun{width:132px!important;height:34px!important;margin:0 auto 5px!important;transform:rotate(-7deg) scale(1.08)!important}.weapon-mini-name{font-size:7px!important;letter-spacing:.15em!important}.weapon-mini-ammo{margin-top:6px!important;gap:6px!important}.weapon-mini-ammo strong{font-size:31px!important}.weapon-mini-ammo span{font-size:13px!important}.weapon-mini-ready{font-size:7px!important;margin-top:4px!important}
.proximity-hud{right:20px!important;top:166px!important;min-width:230px!important;height:62px!important;padding:11px 13px!important;border-radius:13px!important}.proximity-hud span{font-size:7px!important}.proximity-hud b{font-size:15px!important;margin-top:5px!important;color:#ff6578!important}
#controls{left:34px!important;bottom:49px!important;width:226px!important;height:226px!important;opacity:1!important}.joystick-base{border-width:2px!important;background:radial-gradient(circle,rgba(114,247,255,.12),rgba(4,18,23,.48) 58%,rgba(2,8,11,.72))!important;border-color:rgba(225,255,255,.72)!important;box-shadow:0 0 0 8px rgba(255,255,255,.055),0 10px 30px rgba(0,0,0,.35),inset 0 0 22px rgba(114,247,255,.08)!important}.joystick-base:after{inset:45px!important}.joystick-knob{width:112px!important;height:112px!important;margin:-56px 0 0 -56px!important;background:radial-gradient(circle at 35% 30%,rgba(230,255,255,.42),rgba(57,130,143,.48) 52%,rgba(2,15,20,.78))!important;box-shadow:0 5px 18px rgba(0,0,0,.42),inset 0 0 12px rgba(114,247,255,.22)!important}
#fire{right:35px!important;bottom:40px!important;width:150px!important;height:150px!important;font-size:28px!important;border-width:2px!important;background:rgba(4,18,23,.60)!important;border-color:rgba(120,240,255,.52)!important;box-shadow:0 0 30px rgba(0,220,255,.14),inset 0 0 22px rgba(0,220,255,.06)!important}.weapon-label{font-size:8px!important}
#crosshair{width:58px!important;height:58px!important}.hud-left+.top-right-stats{}
/* Keep the tactical map at the same upper-left visual anchor as the reference. */
@media(min-width:701px){
  #game{background:#03090c!important}
}
@media(max-width:700px){
  .top-right-stats{right:10px;top:10px;width:132px;height:54px}.top-right-stats b{font-size:18px}.top-right-stats span{font-size:5px}
  .hud-left{left:66px!important;top:10px!important}.hud-left .health{width:190px!important;height:auto!important;padding:8px 10px!important}
  .bottom-status{left:66px!important;top:64px!important;width:190px!important;min-width:190px!important;height:auto!important;padding:5px!important}
  .hud-center{top:8px!important}.hud-center #timer{font-size:27px!important}.power-rail{gap:4px!important}.power-btn{width:56px!important;height:39px!important}
  .proximity-hud{right:9px!important;top:82px!important;min-width:96px!important;height:auto!important;padding:6px 7px!important}.proximity-hud b{font-size:9px!important}
  .weapon-dock{right:103px!important;bottom:111px!important;width:112px!important;height:auto!important;padding:6px!important}.weapon-mini-ammo strong{font-size:15px!important}
  #controls{left:14px!important;bottom:14px!important;width:116px!important;height:116px!important}.joystick-base:after{inset:27px!important}.joystick-knob{width:54px!important;height:54px!important;margin:-27px 0 0 -27px!important}
  #fire{right:14px!important;bottom:14px!important;width:82px!important;height:82px!important;font-size:11px!important}.top-right-stats{z-index:19}
}

/* ECX // PHYSICAL LANDSCAPE FIT
   Keeps the reference HUD at the same visual size on Android devices
   whose CSS viewport is half the physical pixel width. */
#app.ecx-reference-scaled{
  transform-origin:top left!important;
}
#app.ecx-force-landscape{
  transform-origin:top left!important;
}
/* When the CSS viewport is narrow because of Android DPR, ignore the
   compact mobile HUD rules and keep the exact landscape reference geometry. */
#app.ecx-reference-scaled .hud-left{left:116px!important;top:18px!important;gap:9px!important}
#app.ecx-reference-scaled .hud-left .health{width:352px!important;height:75px!important;padding:12px 22px!important}
#app.ecx-reference-scaled .hud-left .label-row{font-size:10px!important}
#app.ecx-reference-scaled .hud-left .label-row b{font-size:16px!important}
#app.ecx-reference-scaled .hud-left .meter{height:7px!important;margin-top:9px!important}
#app.ecx-reference-scaled .hud-left .submeter{height:4px!important;margin-top:6px!important}
#app.ecx-reference-scaled .bottom-status{left:116px!important;top:101px!important;bottom:auto!important;width:352px!important;min-width:352px!important;height:75px!important;padding:9px!important;gap:7px!important;display:grid!important;grid-template-columns:repeat(4,1fr)!important}
#app.ecx-reference-scaled .bottom-status>div{padding:7px 5px!important}
#app.ecx-reference-scaled .bottom-status span{font-size:7px!important}
#app.ecx-reference-scaled .bottom-status b{font-size:16px!important}
#app.ecx-reference-scaled .bottom-status .boost-status b{font-size:14px!important}
#app.ecx-reference-scaled .hud-center{top:17px!important}
#app.ecx-reference-scaled .hud-center .sector{display:block!important;font-size:10px!important}
#app.ecx-reference-scaled .hud-center #timer{font-size:44px!important}
#app.ecx-reference-scaled .hud-center #lock{font-size:10px!important}
#app.ecx-reference-scaled .mission-strip{margin-top:8px!important;gap:7px!important}
#app.ecx-reference-scaled .mission-strip span{padding:5px 10px!important;font-size:7px!important}
#app.ecx-reference-scaled .power-rail{margin-top:8px!important;gap:9px!important}
#app.ecx-reference-scaled .power-btn{width:120px!important;height:76px!important}
#app.ecx-reference-scaled .power-btn b{font-size:21px!important}
#app.ecx-reference-scaled .power-btn small{font-size:7px!important}
#app.ecx-reference-scaled .power-btn em{font-size:6px!important}
#app.ecx-reference-scaled .top-right-stats{right:20px!important;top:17px!important;width:176px!important;height:74px!important}
#app.ecx-reference-scaled .top-right-stats b{font-size:25px!important}
#app.ecx-reference-scaled .top-right-stats span{font-size:7px!important}
#app.ecx-reference-scaled .proximity-hud{right:20px!important;top:166px!important;min-width:230px!important;height:62px!important;padding:11px 13px!important}
#app.ecx-reference-scaled .proximity-hud span{font-size:7px!important}
#app.ecx-reference-scaled .proximity-hud b{font-size:15px!important}
#app.ecx-reference-scaled .weapon-dock{right:130px!important;bottom:204px!important;width:216px!important;height:140px!important;padding:12px 10px 9px!important}
#app.ecx-reference-scaled .weapon-mini-ammo strong{font-size:31px!important}
#app.ecx-reference-scaled #controls{left:34px!important;bottom:49px!important;width:226px!important;height:226px!important}
#app.ecx-reference-scaled .joystick-base:after{inset:45px!important}
#app.ecx-reference-scaled .joystick-knob{width:112px!important;height:112px!important;margin:-56px 0 0 -56px!important}
#app.ecx-reference-scaled #fire{right:35px!important;bottom:40px!important;width:150px!important;height:150px!important;font-size:28px!important}
#app.ecx-reference-scaled #crosshair{width:58px!important;height:58px!important}
@media (orientation:portrait){
  html,body,#app{overflow:hidden!important}
  body{background:#02070a!important}
}

/* ECHO CITY X // CHARACTER SELECT + INFO EXTENSION */
.character-select{margin:12px auto 0;max-width:430px;text-align:left}
.character-select-title{font-size:7px;letter-spacing:.2em;color:#6faab2;text-align:center;margin-bottom:6px}
.character-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.character-option{position:relative!important;margin:0!important;padding:7px!important;min-height:116px;border:1px solid rgba(120,240,255,.16)!important;border-radius:11px!important;background:rgba(2,10,14,.72)!important;color:#eaffff!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;cursor:pointer!important;box-shadow:none!important;transform:none!important}
.character-option:hover{border-color:rgba(114,247,255,.45)!important}
.character-option.selected{border-color:rgba(114,247,255,.72)!important;background:rgba(8,30,36,.86)!important;box-shadow:0 0 18px rgba(0,220,255,.10),inset 0 0 16px rgba(0,220,255,.04)!important}
.character-option img{width:170px;height:112px;object-fit:contain;object-position:center;display:block;filter:drop-shadow(0 0 10px rgba(114,247,255,.18)) drop-shadow(0 8px 10px rgba(0,0,0,.42));animation:operativeFloat 1.8s ease-in-out infinite;image-rendering:auto}
.character-option:nth-child(2) img{animation-delay:-.55s}
.character-option.selected img{filter:drop-shadow(0 0 16px rgba(114,247,255,.42)) drop-shadow(0 10px 14px rgba(0,0,0,.5))}
.character-option:active img{transform:scale(.96)}

.character-option b{font-size:8px;letter-spacing:.16em;margin-top:2px}
.character-option small{font-size:5px;letter-spacing:.12em;color:#6faab2;margin-top:2px}
.character-check{position:absolute;right:7px;top:6px;font-size:6px;letter-spacing:.12em;color:#66ffb1;opacity:0}
.character-option.selected .character-check{opacity:1}
@keyframes operativeFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
@keyframes operativeReadyPulse{0%,100%{filter:drop-shadow(0 0 8px rgba(114,247,255,.12))}50%{filter:drop-shadow(0 0 20px rgba(114,247,255,.36))}}
.character-option.selected img{animation:operativeFloat 1.8s ease-in-out infinite,operativeReadyPulse 2.1s ease-in-out infinite}

.pause-info{max-height:50vh;overflow:auto;text-align:left;scrollbar-width:none;padding:2px}
.pause-info::-webkit-scrollbar{display:none}
.info-section{padding:11px;margin:0 0 8px;border:1px solid rgba(120,240,255,.11);border-radius:12px;background:linear-gradient(145deg,rgba(4,20,25,.62),rgba(1,8,11,.4));box-shadow:inset 0 0 18px rgba(0,220,255,.025)}
.info-section:last-child{margin-bottom:0}
.info-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}
.info-section h3{font-size:8px;letter-spacing:.18em;color:#72f7ff;margin:0}
.info-section .info-tag{font-size:5px;letter-spacing:.12em;color:#5f9299;padding:4px 6px;border:1px solid rgba(120,240,255,.1);border-radius:999px}
.info-section p{font-size:7.5px;line-height:1.65;color:#b4d0d4;margin:0;letter-spacing:.015em}
.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.info-item{padding:8px;border:1px solid rgba(120,240,255,.08);border-radius:9px;background:rgba(0,0,0,.15)}
.info-item b{display:block;font-size:6px;letter-spacing:.13em;color:#6faab2;margin-bottom:4px}
.info-item span{display:block;font-size:8px;line-height:1.35;color:#eaffff}
.info-list{display:grid;gap:5px}
.info-list div{display:grid;grid-template-columns:92px 1fr;gap:8px;align-items:start;padding:6px 0;border-bottom:1px solid rgba(120,240,255,.06);font-size:7px}
.info-list div:last-child{border-bottom:0}
.info-list b{color:#eaffff;letter-spacing:.08em}.info-list span{color:#8ebbc1;line-height:1.45}
.info-links{display:grid;gap:5px}.info-link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 8px;border:1px solid rgba(120,240,255,.08);border-radius:8px;background:rgba(0,0,0,.12)}
.info-link b{font-size:6px;letter-spacing:.12em;color:#6faab2}.info-links a{font-size:7px;color:#72f7ff;text-decoration:none;overflow-wrap:anywhere;text-align:right}.info-links a:hover{text-decoration:underline}
.pause-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
.pause-actions button{margin:0!important}
@media(max-width:700px){.pause-info{max-height:45vh}.info-grid{grid-template-columns:1fr 1fr}.info-list div{grid-template-columns:82px 1fr}.info-section{padding:9px}.info-section p{font-size:7px}}
@media(max-width:700px){
 .character-select{max-width:360px;margin-top:8px}
 .character-option{min-height:94px!important;padding:5px!important}
 .character-option img{width:118px;height:62px}
 .character-option b{font-size:7px}
 .pause-info{max-height:42vh}
}
@media(max-height:520px) and (orientation:landscape){
 .character-select{margin-top:5px;max-width:380px}
 .character-option{min-height:78px!important}
 .character-option img{width:112px;height:50px}
 .character-option small{display:none}
 .character-option b{font-size:6px}
 .character-select-title{font-size:6px;margin-bottom:3px}
}


/* FINAL CHROME UI/UX PASS — preserve game concepts, improve hierarchy and safe spacing. */
.intro-core{width:min(720px,92vw);max-height:calc(100vh - 96px);overflow:auto;scrollbar-width:none;padding:10px 8px 12px}
.intro-core::-webkit-scrollbar{display:none}
.character-select{width:min(430px,100%)}
.character-grid{gap:10px}
.character-option{min-height:124px!important}
.intro-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.intro-actions button{margin-top:14px!important}
@media(min-width:901px){
  #hud .hud-left{left:28px;top:24px}
  #hud .health{width:330px;padding:14px 18px}
  #hud .top-right-stats{right:28px;top:24px}
  #hud .hud-center{top:20px}
  #hud .weapon-dock{right:28px;top:116px;bottom:auto}
  #hud .proximity-hud{right:28px;top:210px}
  #hud .intel{left:28px;right:28px;bottom:24px;justify-content:space-between}
  #hud .bottom-status{left:50%;transform:translateX(-50%);bottom:112px}
}
@media(max-width:900px){
  .intro-core{width:min(680px,94vw)}
  #hud .hud-center{top:10px;max-width:42vw}
  #hud .hud-center #timer{font-size:26px}
  #hud .weapon-dock{right:10px;top:78px;bottom:auto}
  #hud .proximity-hud{right:10px;top:174px}
  #hud .intel{left:10px;right:10px;bottom:10px;overflow:hidden}
  #hud .bottom-status{left:50%;transform:translateX(-50%);bottom:92px}
}
@media(max-height:600px){
  .intro-core{max-height:calc(100vh - 58px);padding-top:2px}
  .logo-wrap{width:78px!important;height:78px!important}
  .intro-logo{width:60px!important;height:60px!important}
  .character-option{min-height:88px!important}
  .character-option img{width:126px!important;height:64px!important}
  .intro-actions button{margin-top:8px!important;padding:10px 18px!important}
}
.result-card{max-height:calc(100vh - 40px);overflow:auto;scrollbar-width:none}
.result-card::-webkit-scrollbar{display:none}
.result-actions{flex-wrap:wrap}
@media(max-width:560px){
  .result-card{width:min(94vw,760px);padding:20px 14px}
  .result-stats{gap:10px}
  .result-actions{flex-direction:column}
  .result-actions button{width:100%}
}


/* ECX FINAL // LANDSCAPE + PERFORMANCE + INTRO VISIBILITY PASS */
.rotate-notice{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:#02070a;color:#eaffff;text-align:center;padding:24px}
.rotate-notice.hidden{display:none}
.rotate-card{width:min(330px,88vw);padding:28px 22px;border:1px solid rgba(114,247,255,.35);border-radius:22px;background:linear-gradient(145deg,rgba(7,25,31,.96),rgba(2,8,12,.98));box-shadow:0 20px 70px rgba(0,0,0,.6);display:grid;gap:9px;place-items:center}
.rotate-icon{font-size:56px;line-height:1;color:var(--cyan);text-shadow:0 0 25px var(--cyan);animation:rotateHint 1.8s ease-in-out infinite}
.rotate-card b{font-size:18px;letter-spacing:.16em}.rotate-card span{font-size:8px;letter-spacing:.18em;color:var(--cyan)}.rotate-card small{font-size:8px;line-height:1.6;color:#7daeb5}
@keyframes rotateHint{50%{transform:rotate(90deg) scale(1.05)}}
#intro{overflow:hidden!important}
.intro-core{width:min(760px,94vw)!important;max-height:none!important;overflow:visible!important;padding:8px!important}
.intro-top,.intro-footer{font-size:6px!important}
.logo-wrap{width:72px!important;height:72px!important;margin:0 auto 2px!important}.intro-logo{width:54px!important;height:54px!important}
.eyebrow{font-size:7px!important}h1{font-size:clamp(34px,6vw,72px)!important;margin:2px 0!important}
.subtitle{font-size:clamp(8px,1.1vw,13px)!important;letter-spacing:.32em!important}
.system{margin-top:7px!important;padding:5px 9px!important;font-size:7px!important}
.device-time{margin:7px auto 0!important;padding:5px 10px!important}.device-time b{font-size:15px!important}
.brief-grid{margin:7px auto 0!important;gap:5px!important}.brief-grid div{min-width:105px!important;padding:5px 7px!important}.brief-grid small{font-size:5px!important}.brief-grid strong{font-size:7px!important}
.character-select{margin:7px auto 0!important;max-width:360px!important}.character-select-title{font-size:6px!important;margin-bottom:4px!important}.character-grid{gap:7px!important}
.character-option{min-height:62px!important;height:62px!important;padding:5px 8px!important;flex-direction:row!important;justify-content:flex-start!important;gap:8px!important}
.character-option .character-symbol{display:grid;place-items:center;width:34px;height:34px;flex:none;border:1px solid rgba(114,247,255,.28);border-radius:50%;color:var(--cyan);font-size:24px;line-height:1;text-shadow:0 0 12px rgba(114,247,255,.5)}
.character-option b{font-size:8px!important;margin:0!important}.character-option small{font-size:5px!important;margin:0 0 0 auto!important}.character-option img{display:none!important}
.character-check{right:7px!important;top:5px!important;font-size:5px!important}.intro-actions{gap:7px!important}.intro-actions button,.ghost-btn{margin-top:8px!important;padding:10px 15px!important}.hint{margin-top:6px!important;font-size:6px!important}
@media(max-height:600px) and (orientation:landscape){.device-time{display:none!important}.brief-grid{margin-top:5px!important}.logo-wrap{width:56px!important;height:56px!important}.intro-logo{width:42px!important;height:42px!important}.character-option{height:54px!important;min-height:54px!important}.intro-actions button,.ghost-btn{margin-top:5px!important;padding:8px 13px!important}.hint{display:none!important}}
@media(max-width:900px) and (orientation:portrait){#intro,.screen,.overlay-modal,#game,#hud,#result{display:none!important}}
#game{will-change:auto!important}
.noise,.scan-grid,.scan-sweep{animation:none!important}

/* FINAL CROSS-DEVICE UI/UX PASS */
.rotate-notice{pointer-events:none!important;background:rgba(2,7,10,.55)!important;backdrop-filter:blur(3px)}
.rotate-card{pointer-events:none!important}
#result{z-index:60!important;overflow:hidden!important}
#result .result-card{pointer-events:auto!important}
#result .result-actions button{pointer-events:auto!important;touch-action:manipulation!important;cursor:pointer!important}

/* Keep combat status together and inside the safe viewport. */
.bottom-status{z-index:17!important}
.proximity-hud{z-index:18!important}
.weapon-dock{z-index:17!important}
.power-rail{z-index:20!important}

@media (orientation:landscape) and (max-width:700px){
  #hud{font-size:10px}
  .top-right-stats{right:max(8px,env(safe-area-inset-right));top:max(8px,env(safe-area-inset-top));width:118px!important;height:48px!important}
  .top-right-stats span{font-size:5px!important}.top-right-stats b{font-size:16px!important}
  .hud-left{left:max(58px,env(safe-area-inset-left) + 50px)!important;top:max(8px,env(safe-area-inset-top))!important}
  .hud-left .health{width:170px!important;height:47px!important;padding:7px 9px!important;border-radius:11px!important}
  .hud-left .label-row{font-size:6px!important}.hud-left .label-row b{font-size:12px!important}
  .hud-left .meter{height:5px!important;margin-top:5px!important}.hud-left .submeter{height:3px!important;margin-top:4px!important}
  .hud-center{top:7px!important;max-width:42vw!important}
  .hud-center .sector{font-size:6px!important}.hud-center #timer{font-size:24px!important}.hud-center #lock{font-size:6px!important}
  .mission-strip{margin-top:4px!important;gap:3px!important}.mission-strip span{font-size:5px!important;padding:3px 5px!important}
  .power-rail{margin-top:5px!important;gap:4px!important}
  .power-btn{width:64px!important;height:42px!important;border-radius:9px!important;padding:4px!important}
  .power-btn b{font-size:14px!important}.power-btn small{font-size:5px!important}.power-btn em{font-size:4px!important}
  .bottom-status{left:max(58px,env(safe-area-inset-left) + 50px)!important;top:59px!important;width:170px!important;min-width:170px!important;height:45px!important;padding:4px!important;gap:3px!important;border-radius:11px!important;grid-template-columns:repeat(4,1fr)!important}
  .bottom-status>div{padding:4px 2px!important;border-radius:7px!important}.bottom-status span{font-size:4px!important}.bottom-status b{font-size:10px!important}.bottom-status .boost-status b{font-size:9px!important}
  .proximity-hud{right:max(8px,env(safe-area-inset-right))!important;top:65px!important;min-width:104px!important;width:104px!important;height:40px!important;padding:6px 7px!important;border-radius:9px!important}
  .proximity-hud span{font-size:4px!important}.proximity-hud b{font-size:10px!important;margin-top:3px!important}
  .weapon-dock{right:120px!important;bottom:76px!important;width:112px!important;height:72px!important;padding:5px!important;border-radius:9px!important}
  .weapon-mini-gun{width:70px!important;height:18px!important;margin:0 auto 2px!important;transform:rotate(-7deg)!important}
  .weapon-mini-name{font-size:4px!important}.weapon-mini-ammo{margin-top:2px!important;gap:3px!important}.weapon-mini-ammo strong{font-size:15px!important}.weapon-mini-ammo span{font-size:7px!important}.weapon-mini-ready{font-size:4px!important;margin-top:1px!important}
  #controls{left:10px!important;bottom:10px!important;width:132px!important;height:132px!important}
  .joystick-base{width:132px!important;height:132px!important}
  .joystick-base:after{inset:28px!important}
  .joystick-knob{width:62px!important;height:62px!important;margin:-31px 0 0 -31px!important}
  #fire{right:12px!important;bottom:12px!important;width:82px!important;height:82px!important;font-size:16px!important}
  #crosshair{width:32px!important;height:32px!important}
  .intel{left:10px!important;bottom:10px!important;max-width:260px!important;padding:5px 7px!important;gap:5px!important;transform:scale(.78);transform-origin:left bottom}
  .pause-button{right:8px!important;top:58px!important;width:34px!important;height:34px!important}
  .toast-stack{right:8px!important;top:112px!important;max-width:180px!important}
}

/* Portrait is an orientation gate, not a dead-end: the intro remains visible underneath and
   the user can tap ENTER; fullscreen then gets a chance to lock landscape. */
@media (orientation:portrait) and (max-width:700px){
  .rotate-card{width:min(280px,78vw)!important;padding:20px 16px!important}
  .rotate-icon{font-size:42px!important}.rotate-card b{font-size:15px!important}.rotate-card small{font-size:7px!important}
  #intro .intro-core{transform:scale(.82);transform-origin:center center}
}

/* Result screen: both actions always fit side-by-side on phones. */
@media (max-width:700px){
  #result{padding:7px!important}
  #result .result-card{width:min(560px,96vw)!important;max-height:96dvh!important;padding:14px!important;border-radius:16px!important}
  #result .result-card h2{font-size:28px!important}.result-line{font-size:6px!important}.result-card p{font-size:7px!important}
  #result .rating{font-size:32px!important}.result-stats{gap:6px!important}.result-stats b{font-size:13px!important}
  #result .report-bars{margin:7px auto!important}.result-actions{grid-template-columns:1fr 1fr!important;gap:7px!important}
  #result .result-actions button{min-height:44px!important;font-size:8px!important;padding:8px 6px!important}
}


/* ECX // FINAL BUTTON VISIBILITY + CROSS-DEVICE INTRO FIT
   Mobile landscape uses compact 44px touch targets and a fixed-fit intro layout.
   Desktop keeps a roomier 48px action-button target. No intro scrolling required.
*/
.intro-actions button{
  min-height:48px!important;
  padding:12px 22px!important;
}
@media (min-width:901px){
  .intro-actions{gap:10px!important}
  .intro-actions button{min-width:210px!important}
}
@media (orientation:landscape) and (max-width:700px) and (max-height:700px){
  #intro{overflow:hidden!important}
  #intro .intro-core{
    width:min(980px,96vw)!important;
    height:calc(100dvh - 34px)!important;
    max-height:none!important;
    overflow:hidden!important;
    padding:0 6px!important;
    display:flex!important;
    flex-direction:column!important;
    align-items:center!important;
    justify-content:center!important;
    gap:0!important;
  }
  #intro .logo-wrap{
    width:44px!important;height:44px!important;
    margin:0 auto 0!important;
  }
  #intro .intro-logo{width:34px!important;height:34px!important}
  #intro .eyebrow{font-size:6px!important;letter-spacing:.24em!important;margin-top:1px!important}
  #intro h1{
    font-size:clamp(30px,5.5vw,48px)!important;
    line-height:.95!important;
    margin:2px 0!important;
    letter-spacing:.12em!important;
  }
  #intro .subtitle{
    font-size:7px!important;
    line-height:1!important;
    letter-spacing:.30em!important;
  }
  #intro .system{
    margin-top:4px!important;
    padding:4px 8px!important;
    gap:5px!important;
    font-size:6px!important;
  }
  #intro .system i{width:4px!important;height:4px!important}
  #intro .device-time{display:none!important}
  #intro .brief-grid{
    gap:5px!important;
    margin:5px auto 0!important;
  }
  #intro .brief-grid div{
    min-width:105px!important;
    padding:5px 7px!important;
    border-radius:7px!important;
  }
  #intro .brief-grid small{font-size:4px!important}
  #intro .brief-grid strong{font-size:6px!important}
  #intro .character-select{
    width:min(500px,94vw)!important;
    margin-top:5px!important;
  }
  #intro .character-select-title{
    font-size:5px!important;
    margin-bottom:3px!important;
    letter-spacing:.16em!important;
  }
  #intro .character-grid{gap:6px!important}
  #intro .character-option{
    height:56px!important;
    min-height:56px!important;
    padding:4px 8px!important;
    border-radius:9px!important;
    flex-direction:row!important;
    justify-content:center!important;
    gap:7px!important;
  }
  #intro .character-symbol{
    width:28px!important;height:28px!important;
    display:grid!important;place-items:center!important;
    font-size:20px!important;
    border-radius:50%!important;
  }
  #intro .character-option b{font-size:7px!important;margin:0!important}
  #intro .character-option small{display:none!important}
  #intro .character-check{
    right:5px!important;top:4px!important;font-size:4px!important;
  }
  #intro .intro-actions{
    width:min(520px,94vw)!important;
    display:grid!important;
    grid-template-columns:1.35fr 1fr!important;
    gap:7px!important;
    margin-top:6px!important;
  }
  #intro .intro-actions button{
    width:100%!important;
    min-width:0!important;
    min-height:44px!important;
    height:44px!important;
    margin:0!important;
    padding:8px 10px!important;
    border-radius:10px!important;
    font-size:7px!important;
    letter-spacing:.10em!important;
    white-space:nowrap!important;
    touch-action:manipulation!important;
  }
  #intro .intro-actions button span{margin-left:5px!important}
  #intro .ghost-btn{gap:5px!important}
  #intro .ghost-btn .gear{width:8px!important;height:8px!important;border-width:1px!important}
  #intro .ghost-btn .gear::before{inset:-3px!important;border-width:1px!important}
  #intro .hint{display:none!important}
  #intro .intro-top{
    left:10px!important;right:10px!important;top:7px!important;
    font-size:5px!important;
  }
  #intro .intro-footer{
    left:10px!important;right:10px!important;bottom:6px!important;
    font-size:5px!important;
  }
}


/* ============================================================
   ECHO CITY X // DESKTOP BUILD
   Dedicated PC UI: intentionally independent from phone rules.
   ============================================================ */
html.ecx-desktop-build #intro .intro-core{width:min(900px,92vw)!important;max-height:calc(100dvh - 80px)!important;overflow:visible!important}
html.ecx-desktop-build #intro .intro-actions{display:flex!important;justify-content:center!important;gap:12px!important;margin-top:18px!important}
html.ecx-desktop-build #intro .intro-actions button,html.ecx-desktop-build #intro .intro-actions .ghost-btn{height:50px!important;min-height:50px!important;min-width:230px!important;margin:0!important;padding:12px 24px!important;font-size:9px!important}
html.ecx-desktop-build #intro .character-option{min-height:96px!important}
html.ecx-desktop-build #intro .character-option img{display:none!important}
html.ecx-desktop-build #intro .character-option .character-symbol{display:grid!important}

</style>
</head>
<body>
<main id="app">
  <canvas id="game" aria-label="ECHO CITY X game canvas"></canvas>

  <section id="intro" class="screen">
    <div class="noise"></div><div class="scan-grid"></div><div class="scan-sweep"></div>
    <div class="intro-top"><span>ECX // NIGHT OPERATIONS</span><span id="bootStatus">SECURE LINK</span></div>
    <div class="intro-core">
      <div class="logo-wrap"><img class="intro-logo" src="data:image/png;base64," alt="ECHO CITY logo"></div>
      <div class="eyebrow">MADE BY 𝙑𝙀𝙇 ⚡</div>
      <h1>ECHO CITY <b>X</b></h1>
      <div class="subtitle">NIGHTFALL PROTOCOL</div>
      <div class="system"><i></i><span id="bootText">SYSTEM ONLINE</span><b>•</b><span>CITY LINK STABLE</span></div>
      <div class="device-time"><span id="liveDate">--/--/----</span><b id="liveTime">--:--:--</b><small id="deviceZone">DEVICE LOCAL TIME</small></div>
      <div class="brief-grid">
        <div><small>OBJECTIVE</small><strong>SURVIVE 90 SEC</strong></div>
        <div><small>THREAT</small><strong>ADAPTIVE HOSTILES</strong></div>
        <div><small>HAZARD</small><strong>RED / GREEN DEVICES</strong></div>
      </div>
      <div class="character-select" aria-label="Select playable character">
        <div class="character-select-title">SELECT OPERATIVE</div>
        <div class="character-grid">
          <button class="character-option selected" type="button" data-character="male" aria-pressed="true">
            <span class="character-symbol" aria-hidden="true">♂</span><b>MALE</b>
            <small>STANDARD OPERATIVE</small><span class="character-check">SELECTED</span>
          </button>
          <button class="character-option" type="button" data-character="female" aria-pressed="false">
            <span class="character-symbol" aria-hidden="true">♀</span><b>FEMALE</b>
            <small>STANDARD OPERATIVE</small><span class="character-check">SELECTED</span>
          </button>
        </div>
      </div>
      <div class="intro-actions">
        <button id="enter">DEPLOY INTO ECHO CITY <span>↗</span></button>
        <button id="openSettings" class="ghost-btn" type="button" aria-haspopup="dialog"><i class="gear" aria-hidden="true"></i>SETTINGS</button>
      </div>
      <div class="hint">WASD / ARROWS MOVE &nbsp; • &nbsp; F FIRE &nbsp; • &nbsp; R RELOAD &nbsp; • &nbsp; V SPEED + HEALTH BOOST (1 SEC) &nbsp; • &nbsp; P PAUSE</div>
    </div>
    <div class="intro-footer"><span>BUILD ECX-1.1</span><span id="introGfxLabel">GRAPHICS // BALANCED</span><span>AUDIO // DYNAMIC</span></div>
  </section>

  <section id="rotateNotice" class="rotate-notice hidden" aria-hidden="true">
    <div class="rotate-card">
      <div class="rotate-icon">↻</div><b>ROTATE DEVICE</b>
      <span>LANDSCAPE MODE REQUIRED</span>
      <small>Turn your phone sideways to play ECHO CITY X smoothly.</small>
    </div>
  </section>

  <section id="difficultyModal" class="overlay-modal hidden" aria-hidden="true">
    <div class="modal-card difficulty-card">
      <div class="modal-kicker">ECHO CITY X // COMBAT PROFILE</div>
      <h2>SELECT DIFFICULTY</h2>
      <p>Choose the threat profile before deployment. Your choice changes enemy health, pressure, speed and damage.</p>
      <div class="difficulty-grid">
        <button class="difficulty-option" data-difficulty="easy"><b>EASY</b><span>LOW THREAT</span><small>Lower enemy health • slower pressure • forgiving damage</small></button>
        <button class="difficulty-option selected" data-difficulty="medium"><b>MEDIUM</b><span>STANDARD</span><small>Balanced combat • adaptive waves • normal damage</small></button>
        <button class="difficulty-option" data-difficulty="hard"><b>HARD</b><span>HIGH THREAT</span><small>Higher enemy health • faster pressure • heavy damage</small></button>
      </div>
      <div class="difficulty-meta"><span>PROFILE <b id="difficultyLabel">MEDIUM</b></span><span>READY TO DEPLOY</span></div>
      <button id="confirmDifficulty" class="modal-primary">ENTER ECHO CITY <span>↗</span></button>
      <button id="cancelDifficulty" class="modal-secondary">BACK TO INTRO</button>
    </div>
  </section>

  <section id="settingsModal" class="overlay-modal hidden" aria-hidden="true">
    <div class="modal-card pause-card">
      <div class="modal-kicker">ECHO CITY X // SYSTEM CONFIG</div>
      <h2>SETTINGS</h2>
      <div class="pause-tabs settings-tabs">
        <button class="pause-tab active" data-panel="setSound">SOUND</button>
        <button class="pause-tab" data-panel="setGraphics">GRAPHICS</button>
                <button class="pause-tab" data-panel="setButtons">BUTTONS</button>
      </div>
      <div id="setSound" class="pause-panel active">
        <label>MASTER SOUND <input id="settingsSoundVolume" type="range" min="0" max="100" value="82"></label>
        <button id="settingsSoundMute" class="setting-button">MUTE: OFF</button>
      </div>
      <div id="setGraphics" class="pause-panel">
        <div class="setting-row"><span>GRAPHICS QUALITY</span></div>
        <div class="quality-grid">
          <button class="quality-btn" data-quality="low">LOW</button>
          <button class="quality-btn" data-quality="medium">MEDIUM</button>
          <button class="quality-btn" data-quality="high">HIGH</button>
          <button class="quality-btn active" data-quality="ultra">ULTRA</button>
        </div>
        <small class="setting-note">Lower tiers reduce particles, glow and weather density for smoother play on light hardware. Ultra maxes out atmosphere and lighting.</small>
      </div>
      <div id="setButtons" class="pause-panel">
        <div class="controls-list">
          <div><b>W / A / S / D</b><span>MOVE PLAYER</span></div>
          <div><b>F</b><span>FIRE — 3 BULLET BURST</span></div>
          <div><b>V</b><span>SPEED + HEALTH BOOST — 1 SEC</span></div>
          <div><b>R</b><span>RELOAD</span></div>
          <div><b>P / ESC</b><span>PAUSE / RESUME</span></div>
        </div>
      </div>
      <button id="closeSettings" class="modal-primary">SAVE & CLOSE</button>
    </div>
  </section>

  <section id="hud" class="hidden">
    <div class="hud-left">
      <div class="glass health"><div class="label-row"><span>PLAYER INTEGRITY</span><b id="healthText">72</b></div><div class="meter"><i id="healthBar"></i></div><div class="submeter"><i id="armorBar"></i></div></div>
    </div>
    <div class="top-right-stats glass" aria-label="Combat status">
      <div><span>KILLS</span><b id="kills">0</b></div>
      <div><span>ALIVE</span><b id="aliveEnemies">0</b></div>
    </div>
    <div class="hud-center">
      <div class="sector">ECHO CITY X // LIVE OPERATIONS</div>
      <div id="timer">01:30</div>
      <div id="lock">TARGET SEARCHING</div>
      <div class="mission-strip"><span>WAVE <b id="wave">1</b></span><span>THREATS <b id="threats">3</b></span><span>ZONE <b>07</b></span><span>SCORE <b id="score">0</b></span></div>
      <div class="power-rail" aria-label="Power controls">
        <button id="timePlusBtn" class="power-btn time-plus" type="button"><b>+5</b><small>TIME PLUS</small><em>READY</em></button>
        <div class="power-btn combo-display combo-hud"><b id="combo">x1</b><small>COMBO</small><em id="comboState">READY</em></div>
        <button id="speedBoost" class="power-btn speed-health" type="button"><b>⚡</b><small>BOOST</small><em id="speedBoostState">READY</em></button>
      </div>
    </div>
    <div class="weapon-dock" aria-label="Weapon and ammunition">
      <div class="weapon-mini-gun"><i></i><b></b><em></em></div>
      <div class="weapon-mini-name">ECX CARBINE // AUTO</div>
      <div class="weapon-mini-ammo"><strong id="mag">30</strong><span>/</span><strong id="reserve">∞</strong></div>
      <div id="reload" class="weapon-mini-ready">READY</div>
    </div>
    <div class="intel glass">
      <div><span>OBJECTIVE</span><b id="objective">SURVIVE & SECURE</b></div>
      <div><span>WEATHER</span><b id="weather">NIGHT</b></div>
      <div><span>DEVICES</span><b id="bombs">0 RED / 0 GREEN</b></div>
      <div><span>BOMB STRIKES</span><b id="bombStrikes">● ○ ○</b></div>
      <div><span>SCAN</span><b id="visionState">READY [V]</b></div>
      <div><span>TACTICAL</span><b id="tacticalState">READY [Q]</b></div><div><span>STREAK</span><b id="pickupState">NO UPLINK</b></div>
    </div>
    <div id="proximityHud" class="proximity-hud" aria-label="Hostile proximity">
      <span>HOSTILE PROXIMITY</span><b id="proximityState">CLEAR</b>
    </div>
    <div id="bottomStatus" class="bottom-status glass">
      <div><span>HEALTH</span><b id="bottomHealth">72</b></div>
      <div><span>ARMOR</span><b id="bottomArmor">35</b></div>
      <div class="boost-status"><span>SPEED</span><b id="speedState">NORMAL</b></div><div class="boost-status"><span>SHIELD</span><b id="shieldState">35</b></div>
    </div>
    <div id="damageDir" class="damage-dir hidden">⚠</div>
    <div id="toastStack" class="toast-stack"></div>
    <button id="pauseButton" class="pause-button" type="button" aria-label="Pause game"><span class="pause-icon" aria-hidden="true"><i></i><i></i></span></button>
    <div id="giantWarning" class="giant-warning hidden"><div class="warning-symbol">⚠</div></div>
    <div id="pauseBadge" class="pause-overlay hidden">
      <div class="pause-card">
        <div class="modal-kicker">ECHO CITY X // SYSTEM HOLD</div>
        <h2>PAUSED</h2>
        <div class="pause-tabs">
          <button class="pause-tab active" data-panel="pauseSound">SOUND</button>
          <button class="pause-tab" data-panel="pauseGraphics">GRAPHICS</button>
          <button class="pause-tab" data-panel="pauseButtons">CONTROLS</button>
          <button class="pause-tab" data-panel="pauseInfo">INFO</button>
        </div>
        <div id="pauseSound" class="pause-panel active">
          <label>MASTER SOUND <input id="soundVolume" type="range" min="0" max="100" value="82"></label>
          <button id="soundMute" class="setting-button">MUTE: OFF</button>
        </div>
        <div id="pauseGraphics" class="pause-panel">
          <div class="setting-row"><span>GRAPHICS QUALITY</span></div>
          <div class="quality-grid">
            <button class="quality-btn" data-quality="low">LOW</button>
            <button class="quality-btn" data-quality="medium">MEDIUM</button>
            <button class="quality-btn" data-quality="high">HIGH</button>
            <button class="quality-btn active" data-quality="ultra">ULTRA</button>
          </div>
        </div>
        <div id="pauseButtons" class="pause-panel">
          <div class="controls-list">
            <div><b>W / A / S / D</b><span>PLAYER MOVEMENT</span></div>
            <div><b>ARROW KEYS</b><span>PLAYER MOVEMENT</span></div>
            <div><b>F / FIRE</b><span>SHOOTING</span></div>
            <div><b>AUTO AIM</b><span>AUTOMATICALLY TARGETS ENEMIES</span></div>
            <div><b>R</b><span>RELOAD</span></div>
            <div><b>V / Q</b><span>BOOST / TACTICAL PULSE</span></div>
            <div><b>PAUSE</b><span>OPENS THIS MENU + SETTINGS</span></div>
          </div>
        </div>
        <div id="pauseInfo" class="pause-panel">
          <div class="pause-info">
            <section class="info-section">
              <div class="info-section-head"><h3>GAME OVERVIEW</h3><span class="info-tag">AT A GLANCE</span></div>
              <div class="info-grid">
                <div class="info-item"><b>GAME</b><span>ECHO CITY X</span></div>
                <div class="info-item"><b>TYPE</b><span>Shooting + Survival</span></div>
                <div class="info-item"><b>VERSION</b><span>V12.0</span></div>
                <div class="info-item"><b>PLATFORM</b><span>PC + Mobile</span></div>
              </div>
            </section>
            <section class="info-section">
              <div class="info-section-head"><h3>HOW TO PLAY</h3><span class="info-tag">MISSION FLOW</span></div>
              <p>Move through the city, survive enemy attacks, use Auto Aim to target enemies, and keep fighting to build the highest score.</p>
            </section>
            <section class="info-section">
              <div class="info-section-head"><h3>OBJECTIVE</h3><span class="info-tag">GOAL</span></div>
              <div class="info-list">
                <div><b>MAIN GOAL</b><span>Survive as long as possible, kill enemies, and achieve the highest score.</span></div>
                <div><b>WIN</b><span>Survive while fighting and killing enemies. Longer survival and more kills increase your score.</span></div>
                <div><b>LOSE</b><span>The mission ends when enemies or bombs reduce the player's health completely.</span></div>
              </div>
            </section>
            <section class="info-section">
              <div class="info-section-head"><h3>CORE FEATURE</h3><span class="info-tag">COMBAT</span></div>
              <p><b>Auto Aim</b> automatically targets nearby enemies, making combat easier and more user-friendly.</p>
            </section>
            <section class="info-section">
              <div class="info-section-head"><h3>DIFFICULTY</h3><span class="info-tag">CHOOSE YOUR LEVEL</span></div>
              <div class="info-grid">
                <div class="info-item"><b>EASY</b><span>Lower combat pressure</span></div>
                <div class="info-item"><b>MEDIUM</b><span>Balanced challenge</span></div>
                <div class="info-item"><b>HARD</b><span>Higher combat pressure</span></div>
                <div class="info-item"><b>CHARACTERS</b><span>Male + Female</span></div>
              </div>
            </section>
            <section class="info-section">
              <div class="info-section-head"><h3>GAME DETAILS</h3><span class="info-tag">PROJECT</span></div>
              <div class="info-list">
                <div><b>CREATED BY</b><span>Vel⚡</span></div>
                <div><b>TECHNOLOGY</b><span>HTML / CSS / JavaScript</span></div>
                <div><b>DESCRIPTION</b><span>ECHO CITY X is a shooting-survival game focused on fighting enemies, surviving as long as possible, and achieving a high score.</span></div>
              </div>
            </section>
            <section class="info-section">
              <div class="info-section-head"><h3>ABOUT THE DEVELOPER</h3><span class="info-tag">CREATOR</span></div>
              <div class="info-list">
                <div><b>CREATED BY</b><span>Vel⚡</span></div>
                <div><b>TYPE</b><span>Individual Game Developer</span></div>
              </div>
            </section>
            <section class="info-section">
              <div class="info-section-head"><h3>CONTACT</h3><span class="info-tag">CONNECT</span></div>
              <div class="info-links">
                <div class="info-link"><b>EMAIL</b><a href="mailto:nirmalkathir979@gmail.com">nirmalkathir979@gmail.com</a></div>
                <div class="info-link"><b>INSTAGRAM</b><a href="https://instagram.com/ig_kathir_12" target="_blank" rel="noopener">ig_kathir_12</a></div>
                <div class="info-link"><b>GITHUB</b><a href="https://github.com/12kathirvel" target="_blank" rel="noopener">github.com/12kathirvel</a></div>
              </div>
            </section>
          </div>
        </div>
        <div class="pause-actions">
          <button id="resumeGame" class="modal-primary">RESUME MISSION</button>
          <button id="pauseSettings" class="modal-secondary">SETTINGS</button>
          <button id="pauseMenu" class="modal-secondary">MAIN MENU</button>
        </div>
      </div>
    </div>
  </section>

  <div id="crosshair" class="hidden"><i></i><b></b><span></span></div>
  <div id="controls" class="hidden" aria-label="Touch movement control">
    <div id="joystickBase" class="joystick-base" aria-hidden="true">
      <div id="joystickKnob" class="joystick-knob"></div>
    </div>
  </div>
  <div id="weaponView" class="hidden" aria-hidden="true"><div class="hero-arm arm-a"></div><div class="hero-arm arm-b"></div><div class="weapon-body"></div><div class="weapon-barrel"></div><div class="weapon-sight"></div><div class="weapon-label">ECX CARBINE // 30 / ∞</div></div>
  <button id="fire" class="hidden" type="button">F<br><small>FIRE</small></button>

  <section id="result" class="screen hidden">
    <div class="result-card">
      <div class="result-logo"><img src="data:image/png;base64," alt="ECHO CITY logo"></div><div class="result-line" id="resultLine">MISSION REPORT // ECX // SCORE REVEAL</div>
      <h2 id="resultTitle">MISSION SUCCESS</h2>
      <p id="resultInfo">SECTOR SECURED</p>
      <div class="rating" id="rating">S</div>
      <div class="result-stats">
        <span>KILLS <b id="finalKills">0</b></span><span>SCORE <b id="finalScore">0</b></span><span>ACCURACY <b id="finalAccuracy">0%</b></span>
        <span>SURVIVAL <b id="finalTime">00:00</b></span><span>BOMB STRIKES <b id="finalBombs">0/3</b></span><span>BEST COMBO <b id="finalCombo">x1</b></span><span>RELICS <b id="finalRelics">0</b></span>
      </div>
      <div class="report-bars"><div><span>COMBAT</span><i id="combatBar"></i></div><div><span>SURVIVAL</span><i id="survivalBar"></i></div><div><span>CONTROL</span><i id="controlBar"></i></div></div>
      <div class="result-actions"><button id="again">REPLAY MISSION</button><button id="menu">MAIN MENU</button></div>
    </div>
  </section>
</main>
<script>
// Dedicated desktop build marker.
document.documentElement.classList.add('ecx-desktop-build');

(() => {
"use strict";
const $=id=>document.getElementById(id);
const canvas=$('game'),ctx=canvas.getContext('2d');
const intro=$('intro'),hud=$('hud'),result=$('result'),enter=$('enter'),again=$('again'),menu=$('menu'),fireBtn=$('fire'),difficultyModal=$('difficultyModal'),confirmDifficulty=$('confirmDifficulty'),cancelDifficulty=$('cancelDifficulty'),pauseButton=$('pauseButton'),resumeGame=$('resumeGame'),pauseMenu=$('pauseMenu'),pauseSettings=$('pauseSettings');
const cross=$('crosshair'),controls=$('controls'),weaponView=$('weaponView'),speedBoostBtn=$('speedBoost'),tacticalPulseBtn=$('tacticalPulse'),joystickBase=$('joystickBase'),joystickKnob=$('joystickKnob'),characterOptions=document.querySelectorAll('.character-option');
const settingsModal=$('settingsModal'),openSettingsBtn=$('openSettings'),closeSettingsBtn=$('closeSettings'),introGfxLabel=$('introGfxLabel'),timePlusBtn=$('timePlusBtn');
let W=0,H=0,dpr=1,running=false,paused=false,last=0,timeLeft=90,score=0,kills=0,shots=0,hits=0,shake=0,bombStrikes=0,starting=false;
let difficulty='medium',graphicsMode='ultra',filtersEnabled=true,muted=false,masterVolume=.82,fireHeld=false,scoreRevealTimer=null,giantWarningTimer=0,giantSpawned=false,bombShiftTimer=6,touchMoveX=0,touchMoveY=0,joystickPointerId=null;
const keys=new Set(),enemies=[],bullets=[],particles=[],cars=[],buildings=[],lights=[],npcs=[],bombs=[],pickups=[];
const player={x:0,y:0,hp:72,armor:35,speed:255,angle:0,gunAngle:-Math.PI/2,cool:0,inv:0,idle:0,lean:0,moving:false};
let selectedCharacter='male';
// Character selection remains active, but gameplay uses the original procedural
// operative renderer so no reference/combat-sheet artwork appears in the mission.
let ammo=30,reserve=Infinity,reloading=false,reloadTime=0,speedBoostTimer=0,speedBoostCooldown=0,timePlusCooldown=0,boostHealthTimer=0,tacticalCooldown=0,target=null,audio=null,masterGain=null,musicTimer=null,vision=0,weather='NIGHT',weatherTimer=999999,proximityTimer=0,proximityLevel=0,wave=1,spawnClock=0,deviceClockTimer,combo=1,comboTimer=0,bestCombo=1,relics=0,runSeed=0;
const bombTypes={active:{label:'ACTIVE',color:'#ff6578'},safe:{label:'SAFE',color:'#66ffb1'}};
const gfxLevels={low:0,medium:1,high:2,ultra:3};
function gfxLevel(){return gfxLevels[graphicsMode]??3}

const mobilePerformance=false || matchMedia('(pointer:coarse)').matches||innerWidth<800;
let perfFrame=0,perfSlowFrames=0,perfFastFrames=0,perfEffectsReduced=false,lastUiPaint=0;
const PERF_UI_MS=mobilePerformance?90:50;
function renderLevel(){
  if(!mobilePerformance)return gfxLevel();
  /* Medium visual detail is retained; expensive glow/effects are separately capped. */
  return Math.min(gfxLevel(),1);
}
function renderGlowOK(){return !mobilePerformance && !perfEffectsReduced && gfxGlowOK();}

function gfxGlowOK(){return gfxLevel()>=2}
function updateRotateNotice(forcePortrait=(innerHeight>innerWidth)){
  const notice=$('rotateNotice'); if(!notice)return;
  const show=false;
  notice.classList.toggle('hidden',!show);
  notice.setAttribute('aria-hidden',show?'false':'true');
}
function resize(){
  const portrait=innerHeight>innerWidth;
  const app=document.getElementById('app');
  document.documentElement.style.setProperty('--ecx-fit','1');
  if(app){app.classList.remove('ecx-reference-scaled','ecx-force-landscape');app.style.width='100%';app.style.height='100%';app.style.transform='none'}
  W=Math.max(1,innerWidth); H=Math.max(1,innerHeight);
  dpr=matchMedia('(pointer:coarse)').matches ? 1 : Math.min(devicePixelRatio||1,1.5);
  canvas.width=Math.max(1,Math.round(W*dpr)); canvas.height=Math.max(1,Math.round(H*dpr));
  canvas.style.width='100%'; canvas.style.height='100%';
  ctx.setTransform(dpr,0,0,dpr,0,0);
  updateRotateNotice(portrait);
}

addEventListener('resize',resize);addEventListener('fullscreenchange',resize);resize();
const rnd=(a,b)=>a+Math.random()*(b-a),clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
function soundInit(){if(audio)return;try{audio=new (AudioContext||webkitAudioContext)();masterGain=audio.createGain();masterGain.gain.value=masterVolume;masterGain.connect(audio.destination)}catch(e){audio=null;masterGain=null}}
function setMasterVolume(v){masterVolume=clamp(Number(v),0,1);if(masterGain)masterGain.gain.setTargetAtTime(muted?0:masterVolume, audio.currentTime, .025)}
function applyMute(){if(masterGain)masterGain.gain.setTargetAtTime(muted?0:masterVolume, audio.currentTime, .025)}
function tone(f,d,type='sine',g=.03,delay=0,pan=0){if(!audio)return;const o=audio.createOscillator(),a=audio.createGain(),p=audio.createStereoPanner(),t=audio.currentTime+delay;o.type=type;o.frequency.setValueAtTime(f,t);a.gain.setValueAtTime(.0001,t);a.gain.exponentialRampToValueAtTime(Math.max(.0001,g),t+.01);a.gain.exponentialRampToValueAtTime(.0001,t+d);p.pan.value=clamp(pan,-1,1);o.connect(a);a.connect(p);p.connect(masterGain||audio.destination);o.start(t);o.stop(t+d+.04)}
function noise(d=.07,g=.03,pan=0){if(!audio)return;const b=audio.createBuffer(1,Math.max(1,audio.sampleRate*d),audio.sampleRate),data=b.getChannelData(0);for(let i=0;i<data.length;i++)data[i]=(Math.random()*2-1)*(1-i/data.length);const s=audio.createBufferSource(),a=audio.createGain(),p=audio.createStereoPanner();a.gain.value=g;a.gain.exponentialRampToValueAtTime(.0001,a.context.currentTime+d);p.pan.value=pan;s.buffer=b;s.connect(a);a.connect(p);p.connect(masterGain||audio.destination);s.start()}
function music(mode){if(!audio)return;if(musicTimer)clearInterval(musicTimer);const seq=mode==='game'?[55,65.4,73.4,82.4,73.4,98,82.4,65.4]:mode==='win'?[196,247,294,392,494]:[110,146.8,164.8,220,164.8,146.8];let i=0;musicTimer=setInterval(()=>{const f=seq[i++%seq.length];tone(f,.25,'triangle',mode==='game'?.018:.03);tone(f*2,.12,'sine',.008,.04,.2)},mode==='game'?360:520)}
const fireSound=()=>{tone(58,.16,'sawtooth',.16,0,-.2);tone(118,.10,'square',.085,.006,.2);tone(230,.045,'triangle',.045,.018,.1);noise(.095,.12,-.18);noise(.035,.06,.25)};
const reloadSound=()=>{tone(230,.05,'square',.028);tone(390,.07,'square',.03,.1);tone(520,.05,'triangle',.02,.2);tone(180,.12,'triangle',.03,.29)};
const hitSound=()=>{tone(135,.06,'triangle',.04);tone(260,.045,'sine',.02,.035,-.1)};
const boomSound=()=>{tone(42,.5,'sawtooth',.14);tone(70,.35,'triangle',.08,.04,-.25);noise(.42,.1,.1)};
const damageSound=()=>{tone(58,.24,'sawtooth',.07);tone(110,.12,'square',.025,.03,-.2)};
const defeatSound=()=>{tone(180,.18,'sawtooth',.07);tone(135,.24,'sawtooth',.065,.16);tone(92,.42,'triangle',.08,.38);tone(55,.7,'sine',.06,.68);noise(.18,.055,0)};
const victorySound=()=>{tone(220,.16,'triangle',.045);tone(330,.16,'triangle',.04,.16);tone(440,.24,'triangle',.045,.32);tone(660,.34,'sine',.035,.56)}
const pickupSound=()=>{tone(420,.08,'sine',.035);tone(630,.11,'triangle',.03,.07);tone(840,.15,'sine',.022,.15)}
const comboSound=(level)=>{tone(220+level*28,.07,'square',.025);tone(330+level*36,.1,'triangle',.02,.06)}
const pulseSound=()=>{tone(95,.28,'sawtooth',.08);tone(420,.16,'sine',.03,.08);noise(.16,.055,0)}
const enemyAlertSound=(e)=>{const f={giant:58,brute:76,sniper:180,shield:125,runner:240,skitter:310,hunter:145,scout:165}[e.type]||150;tone(f,.08,'square',.014)}
function scoreRevealSound(){if(!audio)return;const notes=[220,277.18,329.63,440,554.37,659.25,880];notes.forEach((f,i)=>{tone(f,.18,'triangle',.045,i*.11);tone(f*2,.08,'sine',.012,i*.11+.035)});tone(110,.55,'sine',.025,.9);tone(220,.5,'triangle',.035,1.05)};
function toast(text,warn=false){const el=document.createElement('div');el.className='toast'+(warn?' warn':'');el.textContent=text;$('toastStack').appendChild(el);setTimeout(()=>el.remove(),2600)}
function cityGenerate(){buildings.length=0;cars.length=0;lights.length=0;npcs.length=0;bombs.length=0;weather=['RAIN','FOG','CLEAR','NIGHT RAIN'][Math.floor(Math.random()*4)];weatherTimer=rnd(12,24);
 for(let x=-1600;x<1600;x+=rnd(120,190))for(let y=-1100;y<1100;y+=rnd(130,200)){if(Math.hypot(x,y)<280)continue;buildings.push({x:x+rnd(-30,30),y:y+rnd(-30,30),w:rnd(80,145),h:rnd(70,140),seed:rnd(0,99)})}
 for(let i=0;i<70;i++)cars.push({x:rnd(-1500,1500),y:Math.round(rnd(-1000,1000)/110)*110,dir:Math.random()<.5?1:-1,s:rnd(40,90)});
 for(let i=0;i<34;i++)npcs.push({x:rnd(-1400,1400),y:rnd(-1000,1000),a:rnd(0,Math.PI*2),s:rnd(18,35),t:rnd(0,3)});
 for(let i=0;i<24;i++){const active=Math.random()<.48;bombs.push({x:rnd(-1250,1250),y:rnd(-850,850),type:active?'active':'safe',armed:active,flash:0,pulse:rnd(0,6)})}
 for(let i=0;i<180;i++)lights.push({x:rnd(-1600,1600),y:rnd(-1100,1100)})}
const difficultyConfig={easy:{hp:.72,speed:.82,damage:.62,cap:18,spawn:.92,enemyCount:7},medium:{hp:1,speed:1,damage:1,cap:24,spawn:.70,enemyCount:9},hard:{hp:1.28,speed:1.15,damage:1.28,cap:29,spawn:.56,enemyCount:11}};
function cfg(){return difficultyConfig[difficulty]||difficultyConfig.medium}
function setDifficulty(mode){difficulty=mode;document.querySelectorAll('.difficulty-option').forEach(b=>b.classList.toggle('selected',b.dataset.difficulty===mode));$('difficultyLabel').textContent=mode.toUpperCase()}
function reset(){giantWarningTimer=0;giantSpawned=false;player.x=0;player.y=0;player.hp=72;player.armor=35;player.inv=0;player.cool=0;player.angle=-Math.PI/2;player.gunAngle=-Math.PI/2;player.idle=0;player.lean=0;player.moving=false;enemies.length=0;bullets.length=0;particles.length=0;bombs.length=0;pickups.length=0;combo=1;comboTimer=0;bestCombo=1;relics=0;tacticalCooldown=0;timePlusCooldown=0;speedBoostCooldown=0;speedBoostTimer=0;boostHealthTimer=0;runSeed=(Math.random()*1e9)|0;timeLeft=90;score=0;kills=0;shots=0;hits=0;bombStrikes=0;ammo=30;reserve=Infinity;reloading=false;wave=1;spawnClock=1.1*cfg().spawn;vision=0;bombShiftTimer=rnd(3,7);weather='NIGHT';cityGenerate();for(let i=0;i<cfg().enemyCount;i++)spawnEnemy(300+i*48);updateUI()}
function spawnEnemy(force=0){
 if(enemies.length>=cfg().cap && !force)return;
 let a,r,x,y,tries=0;
 do{a=rnd(0,Math.PI*2);r=force||rnd(300,560);x=player.x+Math.cos(a)*r;y=player.y+Math.sin(a)*r;tries++}
 while(enemies.some(e=>Math.hypot(e.x-x,e.y-y)<145)&&tries<12);
 const types=['scout','hunter','brute','sniper','runner','shield','skitter'];
 let type=types[Math.floor(rnd(0,types.length))];
 const elite=wave>=3&&Math.random()<Math.min(.22,.06+(wave-3)*.04);
 const scale=(1+(wave-1)*.055)*(elite?1.22:1);
 const base={scout:92,hunter:125,brute:185,sniper:110,runner:105,shield:230,skitter:45}[type];
 const speed={scout:78,hunter:92,brute:52,sniper:64,runner:118,shield:46,skitter:235}[type];
 const hp=base*scale*cfg().hp*1.15;
 enemies.push({x,y,type,hp,max:hp,speed:speed*(1+(wave-1)*.018)*cfg().speed,cool:rnd(.5,1.5),flash:0,orbit:rnd(-1,1),state:'PATROLLING',strafe:rnd(-1,1),phase:rnd(0,6.28),elite});
}
function spawnGiant(){
 let a=rnd(0,Math.PI*2),r=720;
 const x=player.x+Math.cos(a)*r,y=player.y+Math.sin(a)*r;
 const hp=4140;
 enemies.push({x,y,type:'giant',hp,max:hp,speed:38*cfg().speed,cool:1.5,flash:0,orbit:rnd(-1,1),state:'PATROLLING',strafe:0,phase:rnd(0,6.28)});
}
function nearestEnemy(){let best=null,bd=Infinity;for(const e of enemies){const d=dist(player,e);if(d<bd&&d<620){best=e;bd=d}}return best}
function burst(x,y,n,kind='spark',power=180){const mul=mobilePerformance?[.28,.48,.62,.72][gfxLevel()]:[.4,.7,1,1.3][gfxLevel()];n=Math.max(1,Math.round(n*mul));for(let i=0;i<n;i++){const a=rnd(0,Math.PI*2),s=rnd(30,power);particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:rnd(.18,.55),kind})}}
// Shared barrel-tip anchor. Keep projectile, muzzle flash, and firing particles on
// exactly the same point so the shot visually exits the rendered weapon.
const PLAYER_GUN_MUZZLE=72;

function shoot(){
 if(!running||paused||reloading||player.cool>0)return;
 if(ammo<=0){startReload();return}
 ammo--;target=nearestEnemy();
 if(target)player.gunAngle=Math.atan2(target.y-player.y,target.x-player.x);
 const a=player.gunAngle;
 const muzzle=PLAYER_GUN_MUZZLE;
 // One F press = a locked 3-round burst. No long-press auto-fire.
 for(let i=0;i<3;i++){
   shots++;
   const mx=player.x+Math.cos(a)*muzzle;
   const my=player.y+Math.sin(a)*muzzle;
   bullets.push({x:mx,y:my,vx:Math.cos(a)*850,vy:Math.sin(a)*850,life:.7,trail:.045});
 }
 player.cool=.28;fireSound();burst(player.x+Math.cos(a)*muzzle,player.y+Math.sin(a)*muzzle,10,'muzzle',180);updateUI()
}
function startReload(){if(reloading||ammo===30)return;reloading=true;reloadTime=.55;reloadSound();$('reload').textContent='RELOADING';toast('WEAPON RELOAD // IN PROGRESS')}
function damage(n){if(player.inv>0)return;let remaining=n;if(player.armor>0){const a=Math.min(player.armor,Math.ceil(n*.55));player.armor-=a;remaining-=a*.8}player.hp-=Math.max(1,remaining);player.inv=.55;shake=13;damageSound();$('damageDir').classList.remove('hidden');setTimeout(()=>$('damageDir').classList.add('hidden'),250);if(player.hp<=0)end(false)}
function enemyDamage(e,n){e.hp-=n;e.flash=.08;hits++;if(e.hp<=0)kill(e)}
function kill(e){
 kills++;
 const basePts={giant:1000,brute:140,shield:150,sniper:115,hunter:85,runner:70,scout:55,skitter:95}[e.type]||50;
 comboTimer=3.2;combo=Math.min(8,combo+1);bestCombo=Math.max(bestCombo,combo);
 const pts=Math.round(basePts*(1+0.15*(combo-1))*(e.elite?1.5:1));score+=pts;
 const i=enemies.indexOf(e);if(i>=0)enemies.splice(i,1);
 burst(e.x,e.y,e.elite?34:22,'enemy',e.elite?300:220);hitSound();comboSound(combo);
 if(Math.random()<(e.elite?.72:.16))spawnPickup(e.x,e.y,e.elite?'overdrive':(Math.random()<.5?'repair':'relic'));
 toast((e.elite?'ELITE HOSTILE NEUTRALIZED':'HOSTILE NEUTRALIZED')+' // +'+pts+' // COMBO x'+combo,e.elite);
 if(e.type==='giant')spawnPickup(e.x,e.y,'relic');
}
function spawnPickup(x,y,type){pickups.push({x,y,type,life:18,pulse:rnd(0,6.28),spin:rnd(0,6.28)})}
function collectPickup(p){
 p.life=0;relics+=p.type==='relic'?1:0;pickupSound();
 if(p.type==='repair'){player.hp=clamp(player.hp+22,0,72);player.armor=clamp(player.armor+12,0,45);toast('REPAIR CELL // INTEGRITY RESTORED')}
 else if(p.type==='overdrive'){speedBoostCooldown=7;speedBoostTimer=1;boostHealthTimer=1;player.cool=0;player.hp=clamp(player.hp,0,72);toast('OVERDRIVE // SPEED + HEALTH // 1.0 SEC',true)}
 else {score+=300;vision=Math.max(vision,5);toast('ECHO RELIC RECOVERED // +300 SCORE',false)}
}
function activateSpeedHealthBoost(){
 if(!running||paused||speedBoostCooldown>0)return false;
 speedBoostCooldown=7;
 speedBoostTimer=1;
 boostHealthTimer=1;
 player.cool=0;
 player.inv=.12;
 const oldHp=player.hp;
 player.hp=clamp(player.hp,0,72);
 tone(520,.06,'sine',.035);tone(780,.08,'triangle',.03,.05);tone(1040,.10,'sine',.022,.11);
 toast('SPEED + HEALTH BOOST // 1.0 SEC');
 return true;
}
function activateTimePlus(){
 if(!running||paused||timePlusCooldown>0)return false;
 timePlusCooldown=7;
 timeLeft=Math.min(99,timeLeft+5);
 tone(440,.07,'sine',.03);tone(660,.09,'triangle',.025,.06);tone(880,.11,'sine',.018,.13);
 toast('TIME PLUS // +5 SEC');
 return true;
}

function tacticalPulse(){
 if(!running||paused||tacticalCooldown>0)return;
 tacticalCooldown=8;pulseSound();shake=12;burst(player.x,player.y,55,'pulse',360);
 let hits=0;
 for(const e of enemies.slice()){const d=dist(player,e);if(d<300){enemyDamage(e,95*(1-d/360));hits++}}
 vision=Math.max(vision,2.5);toast('TACTICAL PULSE // '+hits+' HOSTILES DISRUPTED',true);
}
function bombStrike(b){b.armed=false;b.flash=.7;bombStrikes++;boomSound();shake=22;toast('ACTIVE DEVICE TRIGGERED // STRIKE '+bombStrikes+'/3',true);damage(28);for(const e of enemies.slice()){const ed=Math.hypot(e.x-b.x,e.y-b.y);if(ed<150)enemyDamage(e,75*(1-ed/150))}burst(b.x,b.y,40,'bomb',300);if(bombStrikes>=3){end(false,'BOMB CRITICAL')} }
function update(dt){if(!running||paused)return;timeLeft-=dt;if(timeLeft<=0){timeLeft=0;end(true);return}
 const elapsed=90-timeLeft;
 if(!giantSpawned && giantWarningTimer<=0 && elapsed>=28){
   giantWarningTimer=2;
   $('giantWarning').classList.remove('hidden');
   tone(130,.16,'sawtooth',.08);tone(90,.22,'sawtooth',.06,.18);tone(180,.08,'square',.05);
 }
 if(giantWarningTimer>0){
   giantWarningTimer-=dt;
   if(giantWarningTimer<=0 && !giantSpawned){
     giantSpawned=true;$('giantWarning').classList.add('hidden');spawnGiant();
     tone(72,.55,'sawtooth',.1);toast('EXTREME THREAT // TARGET APPROACHING',true);shake=10;
   }
 }player.cool=Math.max(0,player.cool-dt);player.inv=Math.max(0,player.inv-dt);speedBoostTimer=Math.max(0,speedBoostTimer-dt);if(boostHealthTimer>0)player.hp=clamp(player.hp+18*dt,0,72);boostHealthTimer=Math.max(0,boostHealthTimer-dt);speedBoostCooldown=Math.max(0,speedBoostCooldown-dt);timePlusCooldown=Math.max(0,timePlusCooldown-dt);tacticalCooldown=Math.max(0,tacticalCooldown-dt);comboTimer=Math.max(0,comboTimer-dt);if(comboTimer<=0)combo=1;spawnClock-=dt;if(spawnClock<=0){spawnClock=Math.max(2.0,5.1-wave*.35)*cfg().spawn;if(enemies.length<Math.min(cfg().cap,6+wave*3))spawnEnemy()}
 const nextWave=Math.min(5,1+Math.floor((90-timeLeft)/18));if(nextWave>wave){wave=nextWave;toast('WAVE '+wave+' // THREAT LEVEL RISING',true);for(let i=0;i<Math.min(2,wave-1);i++)spawnEnemy(560+wave*35)}
 if(reloading){reloadTime-=dt;if(reloadTime<=0){ammo=30;reloading=false;$('reload').textContent='READY';toast('MAGAZINE FULL // 30 / ∞')}}
 const keyDx=(keys.has('ArrowRight')||keys.has('d')?1:0)-(keys.has('ArrowLeft')||keys.has('a')?1:0),keyDy=(keys.has('ArrowDown')||keys.has('s')?1:0)-(keys.has('ArrowUp')||keys.has('w')?1:0);const dx=touchMoveX||keyDx,dy=touchMoveY||keyDy,len=Math.hypot(dx,dy)||1;player.moving=!!(dx||dy);if(dx||dy){const moveSpeed=player.speed*(speedBoostTimer>0?1.85:1);player.x+=dx/len*moveSpeed*dt;player.y+=dy/len*moveSpeed*dt;player.lean=clamp((dx/len)*.18,-.18,.18)}else player.lean*=.9;
 player.idle=(player.idle||0)+dt;
 target=nearestEnemy();if(target){player.gunAngle=Math.atan2(target.y-player.y,target.x-player.x);$('lock').textContent='AUTO AIM // '+target.type.toUpperCase()}else $('lock').textContent='AUTO AIM // SEARCHING';
 let nearest=Infinity;for(const e of enemies)nearest=Math.min(nearest,dist(player,e));proximityLevel=nearest<125?3:nearest<230?2:nearest<360?1:0;proximityTimer-=dt;if(proximityLevel&&proximityTimer<=0){proximityTimer=proximityLevel===3?.35:proximityLevel===2?.7:1.2;if(proximityLevel===3)toast('HOSTILE PROXIMITY // CRITICAL',true)}
 vision=Math.max(0,vision-dt);
 bombShiftTimer-=dt;
 if(bombShiftTimer<=0){
   bombShiftTimer=rnd(2.5,7.5);
   const flips=1+Math.floor(rnd(1,4));
   for(let n=0;n<flips;n++){const b=bombs[Math.floor(rnd(0,bombs.length))];if(b){b.type=b.type==='active'?'safe':'active';b.armed=b.type==='active';b.flash=.25}}
   toast('DEVICE GRID // STATUS SHIFTED',true);
 }
 weather='NIGHT';weatherTimer=999999;
 for(const n of npcs){n.t-=dt;if(n.t<=0){n.a+=rnd(-1.2,1.2);n.t=rnd(1,3)}n.x+=Math.cos(n.a)*n.s*dt;n.y+=Math.sin(n.a)*n.s*dt;if(Math.abs(n.x)>1550)n.a=Math.PI-n.a;if(Math.abs(n.y)>1050)n.a=-n.a}
 for(const b of bombs){b.pulse+=dt;if(!b.armed)continue;const d=Math.hypot(player.x-b.x,player.y-b.y);if(d<48)bombStrike(b)}
 for(const e of enemies){e.cool-=dt;e.flash=Math.max(0,e.flash-dt);e.phase+=dt;const d=dist(player,e);let a=Math.atan2(player.y-e.y,player.x-e.x);if(e.type==='hunter')a+=Math.sin(e.phase*2+e.orbit)*.55;if(e.type==='skitter')a+=Math.sin(e.phase*9)*.6;if(e.type==='giant')a+=Math.sin(e.phase*.45)*.12;if(e.type==='runner')a+=Math.sin(e.phase*5)*.32;if(e.type==='sniper')a+=Math.sin(e.phase*.8)*.18;if(e.type==='shield')a+=Math.sin(e.phase+e.orbit)*.18;e.facing=a;if(d>80){e.x+=Math.cos(a)*e.speed*dt;e.y+=Math.sin(a)*e.speed*dt;e.state=d<330?'ENGAGED':'PATROLLING';e.moving=1}else{e.state='ENGAGED';e.moving=0;if(e.cool<=0){e.cool=e.type==='giant'?1.8:e.type==='brute'?1.3:e.type==='runner'?.9:e.type==='sniper'?1.65:e.type==='skitter'?.75:1.5;const hit={giant:20,brute:15,shield:11,hunter:9,runner:8,sniper:12,scout:7,skitter:5}[e.type];damage(hit*cfg().damage)}}}
 for(let i=0;i<enemies.length;i++)for(let j=i+1;j<enemies.length;j++){const a=enemies[i],b=enemies[j],dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy);if(d>0&&d<62){const push=(62-d)/62*.7,ux=dx/d,uy=dy/d;a.x-=ux*push;a.y-=uy*push;b.x+=ux*push;b.y+=uy*push}}
 for(let i=bullets.length-1;i>=0;i--){const b=bullets[i];b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;let hit=false;for(const e of enemies){if(Math.hypot(b.x-e.x,b.y-e.y)<(e.type==='giant'?34:20)){enemyDamage(e,e.type==='skitter'?999:45);hit=true;break}}if(hit||b.life<=0)bullets.splice(i,1)}
 for(let i=pickups.length-1;i>=0;i--){const p=pickups[i];p.life-=dt;p.pulse+=dt*3;p.spin+=dt*2;if(p.life<=0){pickups.splice(i,1);continue}if(Math.hypot(player.x-p.x,player.y-p.y)<38){collectPickup(p);pickups.splice(i,1)}}
 for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vx*=.97;p.vy*=.97;p.life-=dt;if(p.life<=0)particles.splice(i,1)}
 for(const c of cars){c.x+=c.dir*c.s*dt;if(c.x>1700)c.x=-1700;if(c.x<-1700)c.x=1700}shake=Math.max(0,shake-dt*25);updateUI()}
function draw(){ctx.clearRect(0,0,W,H);const sx=(Math.random()-.5)*shake,sy=(Math.random()-.5)*shake;const bob=player.moving?Math.sin(player.idle*12)*2.5:Math.sin(player.idle*2.4)*.7;const zoom=1+(speedBoostTimer>0?.025:0)+(vision>0?.012:0);ctx.save();ctx.translate(W/2+sx,H/2+sy+bob);ctx.scale(zoom,zoom);ctx.translate(-player.x,-player.y);drawWorld();drawCars();drawNPCs();drawBombs();drawPickups();drawEnemies();drawBullets();drawPlayer();drawParticles();ctx.restore();drawDarkAtmosphere();drawMiniMap()}
function drawWorld(){const lvl=renderLevel();ctx.fillStyle='#07151a';ctx.fillRect(-2000,-1400,4000,2800);for(const b of buildings){ctx.fillStyle='#0b2026';ctx.fillRect(b.x,b.y,b.w,b.h);ctx.strokeStyle='#16434b';ctx.strokeRect(b.x,b.y,b.w,b.h);if(lvl>=1)for(let yy=b.y+12;yy<b.y+b.h-8;yy+=18)for(let xx=b.x+10;xx<b.x+b.w-8;xx+=18)if(((xx+yy+b.seed)|0)%4===0){ctx.fillStyle='#63e6e6';ctx.globalAlpha=lvl>=3?.26:.2;ctx.fillRect(xx,yy,5,7);ctx.globalAlpha=1}}
 ctx.strokeStyle='#0c2b32';ctx.lineWidth=72;for(let x=-1800;x<1800;x+=220){ctx.beginPath();ctx.moveTo(x,-1400);ctx.lineTo(x,1400);ctx.stroke()}for(let y=-1400;y<1400;y+=220){ctx.beginPath();ctx.moveTo(-1800,y);ctx.lineTo(1800,y);ctx.stroke()}ctx.strokeStyle='rgba(115,230,235,.14)';ctx.lineWidth=2;for(let x=-1800;x<1800;x+=220){ctx.beginPath();ctx.moveTo(x,-1400);ctx.lineTo(x,1400);ctx.stroke()}for(let y=-1400;y<1400;y+=220){ctx.beginPath();ctx.moveTo(-1800,y);ctx.lineTo(1800,y);ctx.stroke()}const skip=[5,3,2,1][lvl];ctx.fillStyle='rgba(0,220,255,.16)';for(let i=0;i<lights.length;i+=skip){const l=lights[i];ctx.beginPath();ctx.arc(l.x,l.y,2.5,0,Math.PI*2);ctx.fill()}}
function drawCars(){for(const c of cars){ctx.save();ctx.translate(c.x,c.y);ctx.fillStyle='#152e35';ctx.fillRect(-14,-6,28,12);ctx.fillStyle='#7cfaff';ctx.fillRect(c.dir>0?9:-11,-4,3,3);ctx.fillStyle='#05090b';ctx.fillRect(-10,-8,6,3);ctx.fillRect(4,5,6,3);ctx.restore()}}
function drawNPCs(){for(const n of npcs){ctx.save();ctx.translate(n.x,n.y);ctx.rotate(n.a);ctx.fillStyle='#3b5860';ctx.fillRect(-5,-5,10,13);ctx.fillStyle='#b7e8e8';ctx.beginPath();ctx.arc(0,-10,4,0,Math.PI*2);ctx.fill();ctx.restore()}}
function drawBombs(){for(const b of bombs){ctx.save();ctx.translate(b.x,b.y);const c=b.type==='active'?'#ff6578':'#66ffb1';ctx.globalAlpha=b.armed?.78:Math.max(.15,b.flash*2);ctx.fillStyle=c;ctx.shadowColor=c;ctx.shadowBlur=gfxGlowOK()?18:0;ctx.beginPath();ctx.arc(0,0,10,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.strokeStyle=c;ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,17+Math.sin(b.pulse*4)*3,0,Math.PI*2);ctx.stroke();ctx.fillStyle='#071014';ctx.font='700 6px Arial';ctx.textAlign='center';ctx.fillText(b.type==='active'?'A':'S',0,2);if(b.armed){ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(0,-17,2,0,Math.PI*2);ctx.fill()}ctx.restore()}}
const humanoidTypes=new Set(['scout','hunter','runner']);
function drawLimbs(r,facing,moving,phase,armColor,legColor){
 // Mini-Militia style stick limbs: two legs cycling with movement, one arm gripping a weapon toward facing.
 const stride=moving?Math.sin(phase*9)*r*.5:Math.sin(phase*1.4)*r*.08;
 ctx.strokeStyle=legColor;ctx.lineWidth=Math.max(1.6,r*.16);ctx.lineCap='round';
 ctx.beginPath();ctx.moveTo(-r*.28,r*.55);ctx.lineTo(-r*.28+stride,r*1.15);ctx.stroke();
 ctx.beginPath();ctx.moveTo(r*.28,r*.55);ctx.lineTo(r*.28-stride,r*1.15);ctx.stroke();
 ctx.save();ctx.rotate(facing);
 ctx.strokeStyle=armColor;ctx.lineWidth=Math.max(1.8,r*.18);
 ctx.beginPath();ctx.moveTo(0,-r*.1);ctx.lineTo(r*1.5,0);ctx.stroke();
 ctx.fillStyle='#0a0d0f';ctx.fillRect(r*1.1,-r*.13,r*.85,r*.26);
 ctx.restore();
}
function drawEnemies(){
 const lvl=renderLevel();
 for(const e of enemies){
  ctx.save();ctx.translate(e.x,e.y);
  const r=e.type==='giant'?34:e.type==='brute'?22:e.type==='shield'?23:e.type==='sniper'?17:e.type==='skitter'?12:16;
  ctx.globalAlpha=e.flash>0?.95:1;
  if(e.elite){ctx.shadowColor='#ffd166';ctx.shadowBlur=renderGlowOK()?16:0;ctx.strokeStyle='#ffd166';ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,r+6+Math.sin(e.phase*4)*2,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0}
  if(lvl>=1&&humanoidTypes.has(e.type)&&e.facing!==undefined){
    const limbColor=({hunter:'#5e3315',scout:'#173036',runner:'#42235e'}[e.type]||'#1c2a2e');
    drawLimbs(r,e.facing,e.moving,e.phase,limbColor,limbColor);
  }
  if(e.type==='giant'){
   ctx.shadowBlur=renderGlowOK()?24:0;ctx.shadowColor='#ff1738';ctx.fillStyle='#18060b';
   ctx.beginPath();ctx.moveTo(-30,-30);ctx.lineTo(-17,-42);ctx.lineTo(0,-35);ctx.lineTo(17,-42);ctx.lineTo(30,-30);ctx.lineTo(34,18);ctx.lineTo(20,39);ctx.lineTo(0,45);ctx.lineTo(-20,39);ctx.lineTo(-34,18);ctx.closePath();ctx.fill();
   ctx.strokeStyle='#ff4059';ctx.lineWidth=3;ctx.stroke();
   ctx.fillStyle='#310b12';ctx.fillRect(-27,-18,54,26);
   ctx.fillStyle='#ff1639';ctx.shadowBlur=renderGlowOK()?15:0;ctx.fillRect(-18,-10,11,7);ctx.fillRect(7,-10,11,7);
   ctx.fillStyle='#ff8994';ctx.fillRect(-16,-9,4,2);ctx.fillRect(9,-9,4,2);
   ctx.fillStyle='#6b1723';ctx.fillRect(-30,16,60,7);
   ctx.fillStyle='#ff5268';ctx.fillRect(-24,17,48,3);
   ctx.strokeStyle='rgba(255,80,100,.65)';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-22,30);ctx.lineTo(-14,36);ctx.lineTo(0,31);ctx.lineTo(14,36);ctx.lineTo(22,30);ctx.stroke();
  }else{
   ctx.fillStyle=e.flash>0?'#fff':({brute:'#7d3340',hunter:'#a76b36',runner:'#8d4cbd',sniper:'#3f7891',shield:'#526a72',scout:'#315d68',skitter:'#d7b52e'}[e.type]||'#315d68');
   if(e.type==='runner'||e.type==='skitter'){ctx.rotate(e.phase*(e.type==='skitter'?3:1.5));ctx.fillRect(-r,-r,r*2,r*2)}
   else if(e.type==='sniper'){ctx.rotate(-.2);ctx.fillRect(-r*.7,-r*.8,r*1.4,r*1.6);ctx.fillStyle='#c8f7ff';ctx.fillRect(-3,-r-8,6,8)}
   else if(e.type==='shield'){ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#9cf8ff';ctx.lineWidth=5;ctx.beginPath();ctx.arc(0,0,r-3,-1.2,1.2);ctx.stroke()}
   else if(e.type==='brute'){ctx.fillRect(-r,-r*.8,r*2,r*1.6);ctx.fillStyle='#c45162';ctx.fillRect(-r*.65,-r*.95,r*1.3,5)}
   else{ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill()}
   ctx.strokeStyle=e.state==='ENGAGED'?'#ff6578':'rgba(255,255,255,.2)';ctx.lineWidth=2;ctx.stroke();
   ctx.fillStyle='#080d10';ctx.fillRect(-r*.7,-3,r*1.4,6);
   ctx.fillStyle=e.type==='sniper'?'#ffd26a':e.type==='skitter'?'#fff09a':'#6df5ff';
   ctx.fillRect(-r*.42,-1,r*.24,2);ctx.fillRect(r*.18,-1,r*.24,2);
  }
  const barW=e.type==='giant'?72:r*2;
  ctx.fillStyle='#2b0b10';ctx.fillRect(-barW/2,-r-14,barW,5);
  ctx.fillStyle=e.type==='giant'?'#ff3e59':'#ff7c8c';ctx.fillRect(-barW/2,-r-14,barW*Math.max(0,e.hp/e.max),5);
  ctx.font=e.type==='giant'?'900 8px Arial':'700 6px Arial';ctx.textAlign='center';ctx.fillStyle='#dfffff';ctx.fillText(e.type.toUpperCase(),0,r+13);
  ctx.restore()
 }
}
function drawPickups(){
 for(const p of pickups){
  ctx.save();ctx.translate(p.x,p.y);const pulse=1+Math.sin(p.pulse)*.12;
  const c=p.type==='repair'?'#66ffb1':p.type==='overdrive'?'#ffcf66':'#72f7ff';
  ctx.globalAlpha=p.life<3?Math.max(.2,p.life/3):1;ctx.rotate(p.spin);ctx.scale(pulse,pulse);
  ctx.shadowColor=c;ctx.shadowBlur=gfxGlowOK()?20:0;ctx.strokeStyle=c;ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(0,-12);ctx.lineTo(11,0);ctx.lineTo(0,12);ctx.lineTo(-11,0);ctx.closePath();ctx.stroke();
  ctx.fillStyle=c;ctx.globalAlpha*=.22;ctx.fill();ctx.globalAlpha=p.life<3?Math.max(.2,p.life/3):1;
  ctx.fillStyle='#eaffff';ctx.font='900 7px Arial';ctx.textAlign='center';ctx.fillText(p.type==='repair'?'R':p.type==='overdrive'?'O':'E',0,2);
  ctx.restore();
 }
}
function drawBullets(){
  for(const b of bullets){
    const len=34;
    const speed=Math.hypot(b.vx,b.vy)||1;
    const ux=b.vx/speed,uy=b.vy/speed;
    // Directional tracer begins behind the projectile, making its barrel-tip
    // origin readable on the first visible frame.
    ctx.save();
    ctx.globalAlpha=Math.min(1,(b.trail??.045)/.045);
    ctx.strokeStyle='rgba(220,255,255,.72)';
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.moveTo(b.x-ux*len,b.y-uy*len);
    ctx.lineTo(b.x,b.y);
    ctx.stroke();
    ctx.fillStyle='#dfffff';
    ctx.shadowColor='#bffcff';
    ctx.shadowBlur=8;
    ctx.beginPath();ctx.arc(b.x,b.y,3,0,Math.PI*2);ctx.fill();
    ctx.restore();
  }
}
function drawPlayerFallback(){
 const lvl=renderLevel(),glow=renderGlowOK();
 ctx.save();ctx.translate(player.x,player.y);ctx.globalAlpha=player.inv>0?.55:1;
 ctx.fillStyle='rgba(0,0,0,.45)';ctx.beginPath();ctx.ellipse(0,25,28,10,0,0,Math.PI*2);ctx.fill();
 const breathe=1+Math.sin(player.idle*2.4)*.012,lean=player.lean||0;
 ctx.save();ctx.rotate(lean*.4);ctx.scale(breathe,breathe);
 // Trailing tactical coat — dynamic silhouette flair, streams opposite to movement lean.
 if(lvl>=1){ctx.fillStyle='rgba(10,14,18,.85)';ctx.beginPath();ctx.moveTo(-14,-2);ctx.quadraticCurveTo(-30-lean*40,20,-16-lean*30,34);ctx.lineTo(-4,26);ctx.closePath();ctx.fill();
  ctx.beginPath();ctx.moveTo(14,-2);ctx.quadraticCurveTo(30-lean*40,20,16-lean*30,34);ctx.lineTo(4,26);ctx.closePath();ctx.fill();}
 // Upright hero body — fitted tactical suit, chest emblem strip, utility belt.
 ctx.fillStyle='#11161c';ctx.beginPath();ctx.ellipse(0,10,16,24,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#70f7ff';ctx.lineWidth=2;ctx.stroke();
 ctx.fillStyle='#0c1116';ctx.fillRect(-16,20,32,6);ctx.fillStyle='#70f7ff';ctx.globalAlpha*=.85;ctx.fillRect(-3,21,6,4);ctx.globalAlpha=player.inv>0?.55:1;
 ctx.strokeStyle='rgba(112,247,255,.55)';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(0,-4);ctx.lineTo(0,20);ctx.moveTo(-9,2);ctx.lineTo(-2,10);ctx.moveTo(9,2);ctx.lineTo(2,10);ctx.stroke();
 // Masked head — sealed goggle lenses instead of an exposed face, original design (no third-party branding).
 ctx.fillStyle='#080d12';ctx.beginPath();ctx.arc(0,-14,13,0,Math.PI*2);ctx.fill();
 ctx.fillStyle='#eafcff';if(glow){ctx.shadowColor='#8bfcff';ctx.shadowBlur=9}
 ctx.beginPath();ctx.ellipse(-6,-16,4.4,3,-.15,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.ellipse(6,-16,4.4,3,.15,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
 ctx.strokeStyle='#eafcff';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(-10,-15);ctx.lineTo(10,-15);ctx.moveTo(-1,-16);ctx.lineTo(1,-16);ctx.stroke();
 ctx.restore();
 // Weapon/arms follow auto-aim, independent of body lean/breathing.
 ctx.save();ctx.rotate(player.gunAngle);ctx.fillStyle='#17191a';ctx.fillRect(-7,-8,38,10);ctx.fillStyle='#292b2c';ctx.fillRect(31,-7,34,6);ctx.fillStyle='#0b0c0d';ctx.fillRect(63,-5,19,4);ctx.fillStyle='#21180f';ctx.fillRect(10,2,9,21);ctx.fillStyle='#17252b';ctx.fillRect(-10,-5,15,6);
 if(glow&&player.cool>.07){ctx.fillStyle='#fff';ctx.shadowColor='#bffcff';ctx.shadowBlur=16;ctx.beginPath();ctx.arc(84,-3,4,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0}
 ctx.restore();ctx.restore()}

function drawPlayer(){
 const lvl=renderLevel(),glow=renderGlowOK(),female=selectedCharacter==='female';
 ctx.save();ctx.translate(player.x,player.y);ctx.globalAlpha=player.inv>0?.55:1;
 ctx.fillStyle='rgba(0,0,0,.45)';ctx.beginPath();ctx.ellipse(0,25,28,10,0,0,Math.PI*2);ctx.fill();
 const breathe=1+Math.sin(player.idle*2.4)*.012,lean=player.lean||0;
 ctx.save();ctx.rotate(lean*.4);ctx.scale(breathe,breathe);
 // Same original tactical silhouette for both operatives. Female adds only subtle
 // readable styling differences; gameplay scale, movement and weapon handling stay identical.
 if(lvl>=1){
   ctx.fillStyle='rgba(10,14,18,.85)';
   ctx.beginPath();ctx.moveTo(-14,-2);ctx.quadraticCurveTo(-30-lean*40,20,-16-lean*30,34);ctx.lineTo(-4,26);ctx.closePath();ctx.fill();
   ctx.beginPath();ctx.moveTo(14,-2);ctx.quadraticCurveTo(30-lean*40,20,16-lean*30,34);ctx.lineTo(4,26);ctx.closePath();ctx.fill();
 }
 // Female variant: clearly differentiated silhouette while keeping the exact same
 // gameplay hitbox, scale, movement, aim and weapon handling.
 if(female){
   // Compact ponytail behind the head — visible without using an external image.
   ctx.fillStyle='#070c11';
   ctx.beginPath();
   ctx.moveTo(-9,-20);ctx.quadraticCurveTo(-18,-16,-17,-5);
   ctx.quadraticCurveTo(-15,2,-10,4);ctx.lineTo(-8,-5);
   ctx.closePath();ctx.fill();
   ctx.beginPath();
   ctx.moveTo(9,-19);ctx.quadraticCurveTo(16,-15,18,-7);
   ctx.quadraticCurveTo(20,2,13,7);ctx.quadraticCurveTo(10,2,10,-4);
   ctx.closePath();ctx.fill();
   // Feminine tactical torso: narrower shoulders, tapered waist, slightly defined hips.
   ctx.fillStyle='#11161c';
   ctx.beginPath();
   ctx.moveTo(-11,-5);                         // left shoulder
   ctx.quadraticCurveTo(-15,1,-11,8);
   ctx.lineTo(-8,15);                          // waist
   ctx.quadraticCurveTo(-10,20,-12,22);        // left hip
   ctx.quadraticCurveTo(-6,26,0,26);
   ctx.quadraticCurveTo(6,26,12,22);           // right hip
   ctx.quadraticCurveTo(10,20,8,15);
   ctx.lineTo(11,8);
   ctx.quadraticCurveTo(15,1,11,-5);
   ctx.quadraticCurveTo(5,-8,0,-7);
   ctx.quadraticCurveTo(-5,-8,-11,-5);
   ctx.closePath();ctx.fill();
   ctx.strokeStyle='#70f7ff';ctx.lineWidth=2;ctx.stroke();

   // Shoulder seams and fitted center line make the silhouette readable at gameplay scale.
   ctx.strokeStyle='rgba(112,247,255,.52)';ctx.lineWidth=1.3;
   ctx.beginPath();
   ctx.moveTo(-10,-3);ctx.lineTo(-4,1);ctx.lineTo(-6,14);
   ctx.moveTo(10,-3);ctx.lineTo(4,1);ctx.lineTo(6,14);
   ctx.moveTo(0,0);ctx.lineTo(0,22);
   ctx.stroke();

   // Waist belt and compact boots.
   ctx.fillStyle='#0c1116';ctx.fillRect(-9,17,18,5);
   ctx.fillStyle='#70f7ff';ctx.globalAlpha*=.78;ctx.fillRect(-2,18,4,3);ctx.globalAlpha=player.inv>0?.55:1;
   ctx.fillStyle='#0b1015';ctx.fillRect(-11,22,8,5);ctx.fillRect(3,22,8,5);

   // Smaller helmet/head with a clean ponytail silhouette.
   ctx.fillStyle='#080d12';
   ctx.beginPath();ctx.ellipse(0,-14,11.8,13.2,0,0,Math.PI*2);ctx.fill();
   ctx.fillStyle='#0b1117';
   ctx.beginPath();ctx.moveTo(-9,-20);ctx.quadraticCurveTo(0,-25,9,-20);ctx.lineTo(8,-15);ctx.quadraticCurveTo(0,-18,-8,-15);ctx.closePath();ctx.fill();
   ctx.fillStyle='#eafcff';if(glow){ctx.shadowColor='#8bfcff';ctx.shadowBlur=9}
   ctx.beginPath();ctx.ellipse(-5.2,-16,3.8,2.7,-.16,0,Math.PI*2);ctx.fill();
   ctx.beginPath();ctx.ellipse(5.2,-16,3.8,2.7,.16,0,Math.PI*2);ctx.fill();
   ctx.shadowBlur=0;
   ctx.strokeStyle='#eafcff';ctx.lineWidth=1;
   ctx.beginPath();ctx.moveTo(-9,-15);ctx.lineTo(9,-15);ctx.moveTo(-1,-16);ctx.lineTo(1,-16);ctx.stroke();
 }else{
   // Original male version restored from the first/older build.
   ctx.fillStyle='#11161c';ctx.beginPath();ctx.ellipse(0,10,16,24,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#70f7ff';ctx.lineWidth=2;ctx.stroke();
   ctx.fillStyle='#0c1116';ctx.fillRect(-16,20,32,6);ctx.fillStyle='#70f7ff';ctx.globalAlpha*=.85;ctx.fillRect(-3,21,6,4);ctx.globalAlpha=player.inv>0?.55:1;
   ctx.strokeStyle='rgba(112,247,255,.55)';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(0,-4);ctx.lineTo(0,20);ctx.moveTo(-9,2);ctx.lineTo(-2,10);ctx.moveTo(9,2);ctx.lineTo(2,10);ctx.stroke();
   ctx.fillStyle='#080d12';ctx.beginPath();ctx.arc(0,-14,13,0,Math.PI*2);ctx.fill();
   ctx.fillStyle='#eafcff';if(glow){ctx.shadowColor='#8bfcff';ctx.shadowBlur=9}
   ctx.beginPath();ctx.ellipse(-6,-16,4.4,3,-.15,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.ellipse(6,-16,4.4,3,.15,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
   ctx.strokeStyle='#eafcff';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(-10,-15);ctx.lineTo(10,-15);ctx.moveTo(-1,-16);ctx.lineTo(1,-16);ctx.stroke();
 }
 ctx.restore();
 // Weapon/arms follow auto-aim, identical for both characters.
 ctx.save();ctx.rotate(player.gunAngle);ctx.fillStyle='#17191a';ctx.fillRect(-7,-8,38,10);ctx.fillStyle='#292b2c';ctx.fillRect(31,-7,34,6);ctx.fillStyle='#0b0c0d';ctx.fillRect(63,-5,19,4);ctx.fillStyle='#21180f';ctx.fillRect(10,2,9,21);ctx.fillStyle='#17252b';ctx.fillRect(-10,-5,15,6);
 if(glow&&player.cool>.07){ctx.fillStyle='#fff';ctx.shadowColor='#bffcff';ctx.shadowBlur=16;ctx.beginPath();ctx.arc(84,-3,4,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0}
 ctx.restore();ctx.restore();
}

function drawParticles(){for(const p of particles){ctx.globalAlpha=Math.max(0,p.life*2);ctx.fillStyle=p.kind==='muzzle'?'#fff':p.kind==='enemy'?'#ff7185':p.kind==='bomb'?'#ff9b72':'#79faff';ctx.fillRect(p.x-2,p.y-2,4,4)}ctx.globalAlpha=1}
function drawDarkAtmosphere(){ctx.fillStyle='rgba(0,3,8,.12)';ctx.fillRect(0,0,W,H)}
function drawRain(){
  if(!weather.includes('RAIN')||perfEffectsReduced)return;
  const lvl=mobilePerformance?1:gfxLevel();
  const count=mobilePerformance?18:[0,28,55,90][lvl];
  if(!count)return;
  ctx.strokeStyle='rgba(150,235,255,.16)';
  ctx.lineWidth=1;
  const seed=(perfFrame*13)%997;
  for(let i=0;i<count;i++){
    const x=((i*83+seed*3)%997)/997*W;
    const y=((i*47+seed*5)%997)/997*H;
    ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x-5,y+16);ctx.stroke();
  }
}
function drawWeatherOverlay(){if(weather==='FOG'){ctx.fillStyle='rgba(170,220,225,.09)';ctx.fillRect(0,0,W,H)}if(weather==='NIGHT RAIN'){ctx.fillStyle='rgba(0,8,24,.18)';ctx.fillRect(0,0,W,H)}if(vision>0){ctx.fillStyle='rgba(0,225,255,.055)';ctx.fillRect(0,0,W,H);ctx.strokeStyle='rgba(120,250,255,.2)';ctx.strokeRect(12,12,W-24,H-24);for(const e of enemies){const ex=W/2+(e.x-player.x),ey=H/2+(e.y-player.y);if(ex>-40&&ex<W+40&&ey>-40&&ey<H+40){ctx.fillStyle='rgba(255,100,130,.8)';ctx.beginPath();ctx.arc(ex,ey,7,0,Math.PI*2);ctx.fill()}}}}
function drawMiniMap(){const s=Math.min(220,Math.max(128,Math.round(Math.min(W,H)*.32))),x=20,y=H<=700?Math.min(181,Math.max(86,H-s-185)):Math.min(181,Math.max(86,H-s-185));ctx.fillStyle='rgba(2,9,12,.84)';ctx.fillRect(x,y,s,s);ctx.fillStyle='rgba(210,250,255,.8)';ctx.font='700 7px Arial';ctx.textAlign='left';ctx.fillText('TACTICAL MAP',x+7,y+10);ctx.strokeStyle='rgba(120,240,255,.3)';ctx.strokeRect(x,y,s,s);const scale=.055;ctx.fillStyle='#69faff';ctx.beginPath();ctx.arc(x+s/2,y+s/2,4,0,Math.PI*2);ctx.fill();for(const e of enemies){const ex=x+s/2+(e.x-player.x)*scale,ey=y+s/2+(e.y-player.y)*scale;if(ex>x&&ex<x+s&&ey>y&&ey<y+s){ctx.fillStyle='#ff7185';ctx.fillRect(ex-2.5,ey-2.5,5,5)}}for(const b of bombs){const bx=x+s/2+(b.x-player.x)*scale,by=y+s/2+(b.y-player.y)*scale;if(bx>x&&bx<x+s&&by>y&&by<y+s){ctx.fillStyle=b.type==='active'?'#ff6578':'#66ffb1';ctx.fillRect(bx-1,by-1,3,3)}}}
function updateUI(force=false){
 const now=performance.now();
 if(!force&&now-lastUiPaint<PERF_UI_MS)return;
 lastUiPaint=now;
 const hp=clamp(player.hp,0,100);
 $('healthText').textContent=Math.ceil(hp);$('healthBar').style.width=hp+'%';$('armorBar').style.width=clamp(player.armor,0,100)+'%';
 $('bottomHealth').textContent=Math.ceil(hp);$('bottomArmor').textContent=Math.ceil(player.armor);$('shieldState').textContent=Math.ceil(player.armor);
 $('speedState').textContent=speedBoostTimer>0?(speedBoostTimer.toFixed(1)+'s'):'NORMAL';$('speedBoostState').textContent=speedBoostTimer>0?(speedBoostTimer.toFixed(1)+'s'):(speedBoostCooldown>0?(speedBoostCooldown.toFixed(1)+'s'):'READY');$('speedBoost')?.classList.toggle('cooling',speedBoostCooldown>0);$('timePlusBtn')?.classList.toggle('cooling',timePlusCooldown>0);const timePlusLabel=document.querySelector('#timePlusBtn em');if(timePlusLabel)timePlusLabel.textContent=timePlusCooldown>0?(timePlusCooldown.toFixed(1)+'s'):'READY';
 $('kills').textContent=kills;$('aliveEnemies').textContent=enemies.length;$('score').textContent=score;$('mag').textContent=ammo;$('reserve').textContent='∞';
 const m=Math.floor(timeLeft/60),s=Math.floor(timeLeft%60);$('timer').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
 $('wave').textContent=wave;$('threats').textContent=enemies.length;$('weather').textContent=weather;
 const active=bombs.filter(b=>b.type==='active'&&b.armed).length,safe=bombs.filter(b=>b.type==='safe').length;
 $('bombs').textContent=active+' RED / '+safe+' GREEN';$('bombStrikes').textContent='●'.repeat(bombStrikes)+'○'.repeat(3-bombStrikes);
 $('visionState').textContent=vision>0?'ACTIVE':'READY [V]';$('proximityState').textContent=proximityLevel===3?'DANGER':proximityLevel===2?'NEAR':'CLEAR';$('proximityState').style.color=proximityLevel===3?'#ff6578':'#dffcff';
 $('combo').textContent='x'+combo;$('comboState').textContent=combo>1?(comboTimer.toFixed(1)+'s LINK'):'READY';$('combo').parentElement?.classList.toggle('hot',combo>=4);
 $('tacticalState').textContent=tacticalCooldown>0?(tacticalCooldown.toFixed(1)+'s'):'READY [Q]';$('pickupState').textContent=relics?'RELICS '+relics:'NO UPLINK';
 tacticalPulseBtn?.classList.toggle('ready',tacticalCooldown<=0);
 weaponView.classList.toggle('firing',player.cool>.07)
}
function updateDeviceClock(){const d=new Date();$('liveDate').textContent=d.toLocaleDateString(undefined,{day:'2-digit',month:'2-digit',year:'numeric'});$('liveTime').textContent=d.toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});$('deviceZone').textContent=(Intl.DateTimeFormat().resolvedOptions().timeZone||'LOCAL')+' • DEVICE TIME'}

async function enterGameFullscreen(){
  try{
    if(!document.fullscreenElement && document.documentElement.requestFullscreen){
      const p=document.documentElement.requestFullscreen({navigationUI:'hide'});
      if(p&&p.catch)await p.catch(()=>{});
    }
  }catch(_){}
  try{
    if(screen.orientation?.lock){
      const p=screen.orientation.lock('landscape');
      if(p&&p.catch)await p.catch(()=>{});
    }
  }catch(_){}
  resize();
}

function openDifficulty(){soundInit();if(audio?.state==='suspended')audio.resume();difficultyModal.classList.remove('hidden');difficultyModal.setAttribute('aria-hidden','false');}
function begin(){if(starting)return;if(innerHeight>innerWidth){enterGameFullscreen();setTimeout(()=>{if(innerHeight>innerWidth){updateRotateNotice(true);}else{begin();}},350);return;}starting=true;enterGameFullscreen();soundInit();if(audio?.state==='suspended')audio.resume();reset();result.classList.add('hidden');difficultyModal.classList.add('hidden');intro.classList.remove('hidden');$('bootText').textContent='SYSTEM CHECK // 01';setTimeout(()=>$('bootText').textContent='SYSTEM CHECK // 02',180);setTimeout(()=>$('bootText').textContent='CITY SCAN COMPLETE',360);intro.classList.add('web-burst');setTimeout(()=>{intro.classList.add('hidden');intro.classList.remove('web-burst');hud.classList.remove('hidden');cross.classList.remove('hidden');controls.classList.remove('hidden');fireBtn.classList.remove('hidden');speedBoostBtn?.classList.remove('hidden');tacticalPulseBtn?.classList.remove('hidden');timePlusBtn?.classList.remove('hidden');weaponView.classList.remove('hidden');pauseButton.classList.remove('hidden');running=true;paused=false;starting=false;updateRotateNotice(false);music('game');last=performance.now();toast('MISSION ACCEPTED // '+difficulty.toUpperCase()+' PROFILE',false);requestAnimationFrame(loop)},720)}
function rating(){if(score>=8000)return'S';if(score>=5000)return'A';if(score>=3500)return'B';if(score>=2000)return'C';if(score>=1000)return'D';return'E'}
function end(win,reason=''){if(!running)return;running=false;paused=false;updateRotateNotice(false);if(musicTimer)clearInterval(musicTimer);win?victorySound():defeatSound();scoreRevealSound();hud.classList.add('hidden');cross.classList.add('hidden');controls.classList.add('hidden');fireBtn.classList.add('hidden');speedBoostBtn?.classList.add('hidden');timePlusBtn?.classList.add('hidden');weaponView.classList.add('hidden');$('resultTitle').textContent=win?'MISSION SUCCESS':'MISSION FAILED';$('resultInfo').textContent=win?'SECTOR 07 SECURED // ALL SYSTEMS STABLE':(reason||'SIGNAL LOST // RETRY REQUIRED');$('finalKills').textContent=kills;$('finalScore').textContent=score;document.querySelector('.result-stats span:nth-child(2)')?.classList.add('score-highlight');$('finalAccuracy').textContent=(shots?Math.round(hits/shots*100):0)+'%';$('finalBombs').textContent=bombStrikes+'/3';$('finalTime').textContent=String(Math.floor((90-timeLeft)/60)).padStart(2,'0')+':'+String(Math.floor((90-timeLeft)%60)).padStart(2,'0');$('finalCombo').textContent='x'+bestCombo;$('finalRelics').textContent=relics;$('rating').textContent=rating();$('combatBar').style.width=clamp(kills*5,0,100)+'%';$('survivalBar').style.width=clamp((90-timeLeft)/90*100,0,100)+'%';$('controlBar').style.width=clamp(100-bombStrikes*33,0,100)+'%';result.classList.remove('hidden')}
function togglePause(force){
  if(!running)return;
  paused=typeof force==='boolean'?force:!paused;
  $('pauseBadge').classList.toggle('hidden',!paused);
  if(paused)toast('SYSTEM PAUSED');else{last=performance.now();toast('SYSTEM RESUMED')}
}
function loop(now){
  if(!running)return;
  if(innerHeight>innerWidth){updateRotateNotice(true);requestAnimationFrame(loop);return}
  const frameMs=last?now-last:16.67; last=now;
  if(mobilePerformance){
    if(frameMs>21){perfSlowFrames++;perfFastFrames=0}
    else if(frameMs<17){perfFastFrames++;perfSlowFrames=Math.max(0,perfSlowFrames-1)}
    if(perfSlowFrames>10)perfEffectsReduced=true;
    if(perfFastFrames>90)perfEffectsReduced=false;
  }
  perfFrame++;
  const dt=Math.min(Math.max(frameMs/1000,0),.025);
  update(dt); draw();
  if(running)requestAnimationFrame(loop);
}
function menuBack(){running=false;paused=false;updateRotateNotice(false);result.classList.add('hidden');hud.classList.add('hidden');cross.classList.add('hidden');controls.classList.add('hidden');fireBtn.classList.add('hidden');speedBoostBtn?.classList.add('hidden');timePlusBtn?.classList.add('hidden');tacticalPulseBtn?.classList.add('hidden');weaponView.classList.add('hidden');pauseButton.classList.add('hidden');$('pauseBadge').classList.add('hidden');difficultyModal.classList.add('hidden');intro.classList.remove('hidden');if(musicTimer)clearInterval(musicTimer)}
addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(running&&['w','a','s','d','arrowup','arrowdown','arrowleft','arrowright','f','r','v','q','p','escape',' '].includes(k))e.preventDefault();if(k==='f'){e.preventDefault();if(running&&!paused&&!e.repeat)shoot();return}if(k==='r'&&running&&!paused){e.preventDefault();startReload();return}if(k==='v'&&running&&!paused){e.preventDefault();activateSpeedHealthBoost();return}if(k==='q'&&running&&!paused){e.preventDefault();tacticalPulse();return}if(k==='p'||e.key==='Escape'){e.preventDefault();togglePause();return}keys.add(k);keys.add(e.key)});
addEventListener('keyup',e=>{keys.delete(e.key.toLowerCase());keys.delete(e.key)});
characterOptions.forEach(option=>option.addEventListener('click',()=>{
  selectedCharacter=option.dataset.character||'male';
  characterOptions.forEach(x=>{
    const selected=x.dataset.character===selectedCharacter;
    x.classList.toggle('selected',selected);
    x.setAttribute('aria-pressed',String(selected));
  });
  tone(selectedCharacter==='female'?620:420,.07,'sine',.025);
}));
enter.addEventListener('click',openDifficulty);
function replayMission(){
  result.classList.add('hidden');
  if(innerHeight>innerWidth){
    enterGameFullscreen();
    setTimeout(()=>{ if(innerHeight<=innerWidth) begin(); else updateRotateNotice(true); },350);
    return;
  }
  begin();
}
again.addEventListener('click',replayMission);
menu.addEventListener('click',menuBack);
fireBtn.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();fireHeld=true;fireBtn.setPointerCapture?.(e.pointerId);if(running&&!paused)shoot()});
fireBtn.addEventListener('pointerup',e=>{e.preventDefault();fireHeld=false;try{fireBtn.releasePointerCapture?.(e.pointerId)}catch(_){}});
fireBtn.addEventListener('pointercancel',()=>fireHeld=false);
fireBtn.addEventListener('lostpointercapture',()=>fireHeld=false);
tacticalPulseBtn?.addEventListener('pointerdown',e=>{e.preventDefault();if(running&&!paused)tacticalPulse()});
speedBoostBtn?.addEventListener('pointerdown',e=>{e.preventDefault();activateSpeedHealthBoost()});timePlusBtn?.addEventListener('pointerdown',e=>{e.preventDefault();activateTimePlus()});
// Robust desktop/mobile gameplay fallback: click/tap the fire control or canvas to shoot.
canvas.addEventListener('pointerdown',e=>{
  if(!running||paused)return;
  if(e.pointerType==='mouse' && e.button!==0)return;
  if(e.target===canvas) { e.preventDefault(); shoot(); }
},{passive:false});

function setJoystickFromEvent(e){if(!joystickBase)return;const r=joystickBase.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2,max=Math.max(1,r.width*.56);let dx=e.clientX-cx,dy=e.clientY-cy;const d=Math.hypot(dx,dy);if(d>max){dx=dx/d*max;dy=dy/d*max}touchMoveX=clamp(dx/max,-1,1);touchMoveY=clamp(dy/max,-1,1);if(joystickKnob){joystickKnob.style.transform=`translate(${dx}px,${dy}px)`}}function resetJoystick(){touchMoveX=0;touchMoveY=0;joystickPointerId=null;if(joystickKnob)joystickKnob.style.transform='translate(0,0)'}if(joystickBase){joystickBase.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse')return;e.preventDefault();joystickPointerId=e.pointerId;joystickBase.setPointerCapture?.(e.pointerId);setJoystickFromEvent(e)});joystickBase.addEventListener('pointermove',e=>{if(e.pointerId===joystickPointerId){e.preventDefault();setJoystickFromEvent(e)}});joystickBase.addEventListener('pointerup',e=>{if(e.pointerId===joystickPointerId)resetJoystick()});joystickBase.addEventListener('pointercancel',resetJoystick);joystickBase.addEventListener('lostpointercapture',resetJoystick)}
confirmDifficulty.addEventListener('click',begin);cancelDifficulty.addEventListener('click',()=>difficultyModal.classList.add('hidden'));
document.querySelectorAll('.difficulty-option').forEach(b=>b.addEventListener('click',()=>setDifficulty(b.dataset.difficulty)));
pauseButton.addEventListener('click',()=>togglePause(true));resumeGame.addEventListener('click',()=>togglePause(false));pauseSettings?.addEventListener('click',()=>{soundInit();settingsModal.classList.remove('hidden');settingsModal.setAttribute('aria-hidden','false')});pauseMenu.addEventListener('click',menuBack);
document.querySelectorAll('.pause-tab').forEach(tab=>tab.addEventListener('click',()=>{const scope=tab.closest('.pause-card')||document;scope.querySelectorAll('.pause-tab').forEach(t=>t.classList.remove('active'));scope.querySelectorAll('.pause-panel').forEach(p=>p.classList.remove('active'));tab.classList.add('active');$(tab.dataset.panel).classList.add('active')}));
$('soundVolume').addEventListener('input',e=>setVolume(Number(e.target.value)));$('soundMute').addEventListener('click',()=>setMute(!muted));
function applyGraphicsMode(mode){
 graphicsMode=mode;
 document.querySelectorAll('.quality-btn').forEach(x=>x.classList.toggle('active',x.dataset.quality===mode));
 document.body.classList.remove('gfx-low','gfx-medium','gfx-high','gfx-ultra','performance-mode');
 document.body.classList.add('gfx-'+mode);
 if(mode==='low')document.body.classList.add('performance-mode');
 if(introGfxLabel)introGfxLabel.textContent='GRAPHICS // '+mode.toUpperCase();
}
document.querySelectorAll('.quality-btn').forEach(b=>b.addEventListener('click',()=>applyGraphicsMode(b.dataset.quality)));
const mobileDevice=matchMedia('(pointer:coarse)').matches||innerWidth<800;if(mobileDevice){graphicsMode='medium'}filtersEnabled=false;applyGraphicsMode(graphicsMode);setFilters(false);
function setFilters(on){filtersEnabled=false;document.body.classList.add('filters-off')} 

function setVolume(v){setMasterVolume(v/100);$('soundVolume').value=v;$('settingsSoundVolume').value=v}
function setMute(on){muted=on;applyMute();document.querySelectorAll('#soundMute,#settingsSoundMute').forEach(x=>x.textContent='MUTE: '+(muted?'ON':'OFF'))}
$('settingsSoundVolume').addEventListener('input',e=>setVolume(Number(e.target.value)));
$('settingsSoundMute').addEventListener('click',()=>setMute(!muted));
openSettingsBtn.addEventListener('click',()=>{soundInit();settingsModal.classList.remove('hidden');settingsModal.setAttribute('aria-hidden','false')});
closeSettingsBtn.addEventListener('click',()=>{settingsModal.classList.add('hidden');settingsModal.setAttribute('aria-hidden','true')});
updateDeviceClock();deviceClockTimer=setInterval(updateDeviceClock,1000);cityGenerate();updateUI(true);draw();
})();

</script>
</body>
</html>
